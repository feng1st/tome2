    (id:827, name:"Pazuzu, Lord of Air", ch:"U", color:6, speed:140, hp:"55d100", ac:125, alert:10, aaf:40, depth:82, rarity:2, weight:1, exp:30000, blows:[(method:"HIT", effect:"ELEC", dice:"12d12"), (method:"HIT", effect:"ELEC", dice:"12d12"), (method:"HIT", effect:"ELEC", dice:"12d12"), (method:"HIT", effect:"ELEC", dice:"12d12")], spell_freq:3, spells:["BA_ELEC", "BO_ELEC", "BO_MANA", "MIND_BLAST", "S_HI_DEMON"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 100, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "DEMON", "DROP_4D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "INVISIBLE", "MALE", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "UNIQUE"], hdice:"55", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"A winged humanoid demon from the Planes of Hell, Pazuzu grins inhumanely at you as he decides your fate. "),
