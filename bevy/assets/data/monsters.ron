    (id:719, name:"Nycadaemon", ch:"U", color:3, speed:120, hp:"29d99", ac:80, alert:80, aaf:20, depth:51, rarity:3, weight:1, exp:10000, blows:[(method:"TOUCH", effect:"TERRIFY", dice:"0d0"), (method:"CLAW", effect:"HURT", dice:"6d6"), (method:"CLAW", effect:"HURT", dice:"6d6"), (method:"CLAW", effect:"HURT", dice:"6d6")], spell_freq:4, spells:["BLINK", "BRAIN_SMASH", "BR_NETH", "CONF", "HOLD", "S_DEMON"], open_door:false, bash_door:false, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 0, 50, 0), flags:["AURA_FIRE", "CAN_FLY", "DEMON", "DROP_1D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_ACID", "IM_COLD", "IM_FIRE", "INVISIBLE", "KILL_WALL", "NONLIVING", "NO_CONF", "NO_SLEEP", "NO_STUN", "ONLY_ITEM", "REGENERATE"], hdice:"29", hside:"99", body_parts:(1, 1, 1, 2, 1, 1), desc:"A loathsome, sturdy, winged, horned demon, with talons that could tear a stone wall down. "),
    (id:720, name:"Barbazu", ch:"U", color:13, speed:120, hp:"120d10", ac:60, alert:80, aaf:25, depth:55, rarity:2, weight:1, exp:3000, blows:[(method:"HIT", effect:"HURT", dice:"4d10"), (method:"HIT", effect:"HURT", dice:"4d10"), (method:"HIT", effect:"LOSE_CON", dice:"10d2"), (method:"STING", effect:"POISON", dice:"5d5")], spell_freq:7, spells:["SCARE", "S_DEMON"], open_door:true, bash_door:true, never_move:false, unique:false, friends:true, escort:false, artifact_idx:0, artifact_chance:0, objs:(20, 40, 20, 20), flags:["BASH_DOOR", "DEMON", "DROP_1D2", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "FRIENDS", "IM_POIS", "NONLIVING", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL"], hdice:"120", hside:"10", body_parts:(1, 1, 1, 2, 1, 1), desc:"A foul, humanoid creature with a long tail, clawed hands and feet, and a disgusting, wiry, snaky beard.  They are the elite shock troops of the hells, capable of a terrifying berserk fury. "),
    (id:722, name:"Nightwing", ch:"W", color:8, speed:120, hp:"60d60", ac:120, alert:10, aaf:20, depth:61, rarity:4, weight:1, exp:10000, blows:[(method:"TOUCH", effect:"POISON", dice:"6d5"), (method:"TOUCH", effect:"POISON", dice:"6d5"), (method:"HIT", effect:"UN_BONUS", dice:"6d8"), (method:"HIT", effect:"UN_BONUS", dice:"6d8")], spell_freq:4, spells:["BA_NETH", "BLIND", "BO_MANA", "BO_NETH", "BRAIN_SMASH", "CAUSE_4", "SCARE", "S_UNDEAD"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 100, 0), flags:["BASH_DOOR", "CAN_FLY", "COLD_BLOOD", "DROP_2D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HURT_LITE", "IM_COLD", "IM_POIS", "NO_CONF", "NO_CUT", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "RES_TELE", "SMART", "UNDEAD"], hdice:"60", hside:"60", body_parts:(1, 1, 1, 2, 1, 1), desc:"Everywhere colours seem paler and the air chiller. At the centre of the cold stands a mighty figure. Its wings envelop you in the chill of death as the nightwing reaches out to draw you into oblivion. Your muscles sag and your mind loses all will to fight as you stand in awe of this mighty being. "),
    (id:723, name:"Maulotaur", ch:"H", color:2, speed:130, hp:"250d13", ac:50, alert:10, aaf:13, depth:50, rarity:2, weight:40000, exp:4500, blows:[(method:"HIT", effect:"SHATTER", dice:"8d8"), (method:"HIT", effect:"SHATTER", dice:"8d8"), (method:"BUTT", effect:"HURT", dice:"4d6"), (method:"BUTT", effect:"HURT", dice:"4d6")], spell_freq:5, spells:["BA_FIRE", "BO_PLAS"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 50, 50, 0), flags:["BASH_DOOR", "DROP_60", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_FIRE", "MORTAL", "ONLY_ITEM", "RES_TELE", "STUPID"], hdice:"250", hside:"13", body_parts:(1, 1, 1, 2, 1, 1), desc:"It is a belligerent minotaur with a destructive magical arsenal, armed with a hammer. "),
    (id:724, name:"Nether hound", ch:"Z", color:13, speed:120, hp:"60d10", ac:100, alert:0, aaf:30, depth:51, rarity:2, weight:800, exp:5000, blows:[(method:"CLAW", effect:"HURT", dice:"2d12"), (method:"CLAW", effect:"HURT", dice:"2d12"), (method:"BITE", effect:"HURT", dice:"2d12"), (method:"BITE", effect:"HURT", dice:"2d12")], spell_freq:5, spells:["BR_NETH"], open_door:true, bash_door:true, never_move:false, unique:false, friends:true, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "BASH_DOOR", "DROP_CORPSE", "DROP_SKELETON", "FORCE_SLEEP", "FRIENDS", "MORTAL", "NO_CONF", "NO_CUT", "NO_SLEEP", "OPEN_DOOR", "RES_NETH"], hdice:"60", hside:"10", body_parts:(0, 1, 0, 2, 1, 0), desc:"You feel a soul-tearing chill upon viewing this beast, a ghostly form of darkness in the shape of a large dog. "),
    (id:725, name:"Time hound", ch:"Z", color:14, speed:130, hp:"60d10", ac:100, alert:0, aaf:30, depth:51, rarity:2, weight:800, exp:5000, blows:[(method:"CLAW", effect:"HURT", dice:"2d12"), (method:"CLAW", effect:"HURT", dice:"2d12"), (method:"BITE", effect:"HURT", dice:"2d12"), (method:"BITE", effect:"HURT", dice:"2d12")], spell_freq:5, spells:["BR_TIME"], open_door:true, bash_door:true, never_move:false, unique:false, friends:true, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "BASH_DOOR", "DROP_CORPSE", "DROP_SKELETON", "FORCE_SLEEP", "FRIENDS", "MORTAL", "NO_CONF", "NO_SLEEP", "OPEN_DOOR"], hdice:"60", hside:"10", body_parts:(0, 1, 0, 2, 1, 0), desc:"You get a terrible sense of deja vu, or is it a premonition?  All at once you see a little puppy and a toothless old dog. Perhaps you should give up and go to bed. "),
