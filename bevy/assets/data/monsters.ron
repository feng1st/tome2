    (id:802, name:"Greater rotting quylthulg", ch:"Q", color:15, speed:120, hp:"15d100", ac:1, alert:0, aaf:20, depth:71, rarity:2, weight:5000, exp:10500, blows:[], spell_freq:2, spells:["BLINK", "S_HI_UNDEAD", "TELE_TO"], open_door:false, bash_door:false, never_move:true, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "EMPTY_MIND", "FORCE_MAXHP", "FORCE_SLEEP", "INVISIBLE", "NEVER_BLOW", "NEVER_MOVE", "NO_CONF", "NO_CUT", "NO_FEAR", "NO_SLEEP", "RES_TELE"], hdice:"15", hside:"100", body_parts:(0, 0, 0, 0, 0, 0), desc:"A massive pile of rotting flesh. A disgusting stench fills the air as it throbs and writhes. "),
    (id:804, name:"Feagwath, the Undead Sorcerer", ch:"L", color:11, speed:130, hp:"60d100", ac:85, alert:50, aaf:20, depth:77, rarity:2, weight:1900, exp:30000, blows:[(method:"TOUCH", effect:"EXP_80", dice:"6d12"), (method:"TOUCH", effect:"UN_POWER", dice:"6d12"), (method:"TOUCH", effect:"LOSE_DEX", dice:"6d12"), (method:"TOUCH", effect:"LOSE_DEX", dice:"6d12")], spell_freq:2, spells:["BA_MANA", "BA_NETH", "BLINK", "BO_MANA", "BRAIN_SMASH", "CAUSE_4", "HOLD", "SCARE", "S_KIN", "S_MONSTERS", "S_UNDEAD", "TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:true, artifact_idx:0, artifact_chance:0, objs:(0, 50, 50, 0), flags:["BASH_DOOR", "CAN_SPEAK", "COLD_BLOOD", "DROP_2D2", "DROP_4D2", "DROP_GOOD", "DROP_GREAT", "ESCORT", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "IM_POIS", "MALE", "NO_CONF", "NO_CUT", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "RES_TELE", "SMART", "SPECIAL_GENE", "UNDEAD", "UNIQUE"], hdice:"60", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"A stench of corruption and decay surrounds this sorcerer, who has clearly risen from the dead to continue his foul plots and schemes. "),
    (id:805, name:"Omarax the Eye Tyrant", ch:"e", color:10, speed:130, hp:"65d100", ac:80, alert:10, aaf:30, depth:73, rarity:3, weight:600, exp:25000, blows:[(method:"GAZE", effect:"UN_BONUS", dice:"6d6"), (method:"GAZE", effect:"UN_POWER", dice:"6d6"), (method:"GAZE", effect:"INSANITY", dice:"6d6"), (method:"BITE", effect:"EXP_80", dice:"8d8")], spell_freq:2, spells:["BA_ACID", "BA_COLD", "BA_DARK", "BA_FIRE", "BA_NETH", "BLIND", "BO_MANA", "BRAIN_SMASH", "CONF", "DRAIN_MANA", "FORGET", "SCARE", "S_KIN"], open_door:false, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_POIS", "MALE", "RES_TELE", "SMART", "UNIQUE"], hdice:"65", hside:"100", body_parts:(0, 0, 0, 0, 0, 0), desc:"A beholder of great size and age, floating in the air.  His gaze seems to shred your soul and his spells crush your will.  He is ancient, his history steeped in forgotten evils, his atrocities numerous and sickening. "),
    (id:807, name:"Greater Balrog", ch:"U", color:10, speed:130, hp:"75d100", ac:140, alert:40, aaf:40, depth:80, rarity:3, weight:1, exp:25000, blows:[(method:"HIT", effect:"FIRE", dice:"8d12"), (method:"HIT", effect:"FIRE", dice:"8d12"), (method:"CRUSH", effect:"HURT", dice:"7d12"), (method:"TOUCH", effect:"UN_POWER", dice:"0d0")], spell_freq:3, spells:["BA_FIRE", "BA_NETH", "BLIND", "BO_PLAS", "BRAIN_SMASH", "BR_FIRE", "BR_PLAS", "CONF", "S_DEMON", "S_HI_DEMON", "S_UNDEAD"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 50, 50, 0), flags:["AURA_FIRE", "BASH_DOOR", "CAN_FLY", "DEMON", "DROP_2D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_FIRE", "KILL_WALL", "MOVE_BODY", "NONLIVING", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "REGENERATE", "RES_NETH", "RES_PLAS", "SMART"], hdice:"75", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"Originally of the semi-divine Maiar, this evil spirit swore allegiance to Morgoth at the beginning of time and is now one of his most terrible demonic servants.  With its flaming whip and sword it seeks to destroy you. "),
    (id:808, name:"Ungoliant, the Unlight", ch:"S", color:8, speed:130, hp:"130d100", ac:160, alert:80, aaf:8, depth:75, rarity:1, weight:1500, exp:35000, blows:[(method:"CLAW", effect:"POISON", dice:"8d6"), (method:"CLAW", effect:"POISON", dice:"8d6"), (method:"BITE", effect:"PARALYZE", dice:"8d10"), (method:"STING", effect:"LOSE_STR", dice:"8d4")], spell_freq:3, spells:["BA_DARK", "BLIND", "BR_DARK", "BR_POIS", "CONF", "DARKNESS", "HEAL", "SCARE", "SLOW", "S_SPIDER"], open_door:false, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(20, 0, 80, 0), flags:["ANIMAL", "BASH_DOOR", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FEMALE", "FORCE_MAXHP", "FORCE_SLEEP", "HURT_LITE", "IM_ACID", "IM_POIS", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "SMART", "SPIDER", "UNIQUE"], hdice:"130", hside:"100", body_parts:(0, 1, 0, 2, 1, 0), desc:"This enormous, hideous spirit of void is in the form of a spider of immense proportions.  She is surrounded by a cloud of Unlight as she sucks in all living light into her bloated body, and breathes out the blackest of darkness.  She is always ravenously hungry and would even eat herself to avoid starvation. "),
    (id:811, name:"Aether hound", ch:"Z", color:10, speed:120, hp:"60d40", ac:100, alert:0, aaf:30, depth:74, rarity:3, weight:1000, exp:10000, blows:[(method:"BITE", effect:"HURT", dice:"3d12"), (method:"BITE", effect:"HURT", dice:"3d12"), (method:"CLAW", effect:"HURT", dice:"3d12"), (method:"CLAW", effect:"HURT", dice:"3d12")], spell_freq:5, spells:["BR_ACID", "BR_CHAO", "BR_COLD", "BR_CONF", "BR_DARK", "BR_DISE", "BR_ELEC", "BR_FIRE", "BR_GRAV", "BR_INER", "BR_LITE", "BR_NETH", "BR_NEXU", "BR_PLAS", "BR_POIS", "BR_SHAR", "BR_SOUN", "BR_TIME", "BR_WALL"], open_door:false, bash_door:true, never_move:false, unique:false, friends:true, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "ATTR_ANY", "ATTR_MULTI", "AURA_COLD", "AURA_ELEC", "AURA_FIRE", "BASH_DOOR", "CAN_FLY", "DROP_CORPSE", "DROP_SKELETON", "FORCE_SLEEP", "FRIENDS", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "NO_CONF", "NO_CUT", "NO_SLEEP", "RES_DISE", "RES_NETH", "RES_NEXU", "RES_PLAS"], hdice:"60", hside:"40", body_parts:(0, 1, 0, 2, 1, 0), desc:"A shifting, swirling form. It seems to be all colours and sizes and shapes, though the dominant form is that of a huge dog. You feel very uncertain all of a sudden. "),
    (id:812, name:"Pit Fiend", ch:"U", color:3, speed:130, hp:"60d100", ac:120, alert:75, aaf:30, depth:77, rarity:3, weight:1, exp:22000, blows:[(method:"CLAW", effect:"FIRE", dice:"8d10"), (method:"CLAW", effect:"FIRE", dice:"8d10"), (method:"BITE", effect:"POISON", dice:"7d10"), (method:"BITE", effect:"LOSE_CON", dice:"7d10")], spell_freq:5, spells:["BA_CHAO", "BA_FIRE", "BR_CHAO", "BR_FIRE", "BR_POIS", "CAUSE_4", "SCARE", "S_HI_DEMON", "S_HI_DRAGON"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 100, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "DEMON", "DROP_2D2", "DROP_4D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_FIRE", "IM_POIS", "MOVE_BODY", "NONLIVING", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "REGENERATE"], hdice:"60", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"Appearing as a giant, clawed and winged humanoid with a scaly red body and massive fangs dripping a foul green liquid, the Pit Fiend is a dreadful enemy from the lowest depths of the hells.  They are often the commanders of vast demon armies. "),
    (id:818, name:"The Mouth of Sauron", ch:"p", color:10, speed:130, hp:"90d100", ac:100, alert:10, aaf:60, depth:78, rarity:3, weight:1900, exp:38000, blows:[(method:"HIT", effect:"UN_BONUS", dice:"6d8"), (method:"HIT", effect:"UN_BONUS", dice:"6d8"), (method:"TOUCH", effect:"UN_POWER", dice:"0d0"), (method:"TOUCH", effect:"UN_POWER", dice:"0d0")], spell_freq:2, spells:["BA_DARK", "BA_FIRE", "BA_MANA", "BA_NETH", "BA_WATE", "BO_PLAS", "CAUSE_3", "HOLD", "S_HI_DEMON", "S_HI_UNDEAD", "TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 100, 0), flags:["BASH_DOOR", "DROP_1D2", "DROP_4D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_COLD", "IM_ELEC", "IM_FIRE", "INVISIBLE", "MALE", "ONLY_ITEM", "OPEN_DOOR", "SMART", "UNIQUE"], hdice:"90", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"The Mouth of Sauron is a mighty spell caster. So old that even he cannot remember his own name, his power and evil are undeniable. He believes unshakeably that he is unbeatable and laughs as he weaves his awesome spells. "),
    (id:819, name:"The Necromancer of Dol Guldur", ch:"p", color:10, speed:130, hp:"82d100", ac:100, alert:10, aaf:60, depth:75, rarity:3, weight:1900, exp:40000, blows:[(method:"HIT", effect:"UN_BONUS", dice:"6d8"), (method:"HIT", effect:"UN_POWER", dice:"6d8"), (method:"HIT", effect:"BLIND", dice:"6d8"), (method:"HIT", effect:"CONFUSE", dice:"6d8")], spell_freq:2, spells:["BA_CHAO", "BA_DARK", "BA_FIRE", "BA_MANA", "BA_NETH", "BA_WATE", "BO_PLAS", "CAUSE_3", "DRAIN_MANA", "HAND_DOOM", "HOLD", "S_HI_UNDEAD", "TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 100, 0), flags:["BASH_DOOR", "CAN_SPEAK", "DROP_1D2", "DROP_GOOD", "DROP_GREAT", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "IM_ELEC", "IM_FIRE", "INVISIBLE", "MALE", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "RES_TELE", "SMART", "SPECIAL_GENE", "UNIQUE"], hdice:"82", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"The dark master of the terrible fortress of southern Mirkwood.  It is rumoured that this is in fact none other than Sauron in disguise: although if this is so, he has yet to reveal his full power - and perhaps will not do so while his deception lasts, in the hope of keeping it going. "),
    (id:820, name:"Lisa, rider of gold Romth", ch:"B", color:11, speed:130, hp:"65d100", ac:100, alert:15, aaf:100, depth:78, rarity:6, weight:420000, exp:35500, blows:[(method:"HIT", effect:"HURT", dice:"10d15"), (method:"HIT", effect:"HURT", dice:"10d15"), (method:"HIT", effect:"HURT", dice:"10d15"), (method:"HIT", effect:"HURT", dice:"10d15")], spell_freq:4, spells:["BA_FIRE", "BA_NETH", "BO_FIRE", "BO_NETH", "BR_FIRE", "HEAL", "S_THUNDERLORD", "TELE_AWAY", "TELE_TO", "TPORT"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DROP_1D2", "DROP_4D2", "DROP_60", "DROP_90", "DROP_CORPSE", "DROP_GOOD", "DROP_SKELETON", "FEMALE", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_POIS", "MORTAL", "ONLY_ITEM", "OPEN_DOOR", "PET", "REGENERATE", "RES_TELE", "THUNDERLORD", "UNIQUE"], hdice:"65", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"She came to help you. "),
    (id:821, name:"Master quylthulg", ch:"Q", color:14, speed:120, hp:"30d100", ac:1, alert:0, aaf:20, depth:76, rarity:2, weight:7000, exp:15000, blows:[], spell_freq:2, spells:["BLINK", "S_ANIMALS", "S_HI_DEMON", "S_HI_DRAGON", "S_HI_UNDEAD", "S_MONSTERS", "TELE_TO"], open_door:false, bash_door:false, never_move:true, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "EMPTY_MIND", "FORCE_MAXHP", "FORCE_SLEEP", "INVISIBLE", "NEVER_BLOW", "NEVER_MOVE", "NO_CONF", "NO_FEAR", "NO_SLEEP", "RES_TELE"], hdice:"30", hside:"100", body_parts:(0, 0, 0, 0, 0, 0), desc:"A giant seething mass of flesh, overwhelming you with monster after monster. "),
    (id:822, name:"Qlzqqlzuup, the Lord of Flesh", ch:"Q", color:10, speed:130, hp:"50d100", ac:1, alert:0, aaf:30, depth:79, rarity:3, weight:10000, exp:20000, blows:[], spell_freq:1, spells:["S_ANGEL", "S_ANIMALS", "S_ANT", "S_HI_DEMON", "S_HI_DRAGON", "S_HI_UNDEAD", "S_HOUND", "S_HYDRA", "S_KIN", "S_MONSTERS", "S_SPIDER", "S_UNIQUE", "S_WRAITH"], open_door:false, bash_door:false, never_move:true, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(20, 20, 20, 20), flags:["ANIMAL", "ATTR_MULTI", "DROP_4D2", "EMPTY_MIND", "FORCE_MAXHP", "FORCE_SLEEP", "INVISIBLE", "NEVER_BLOW", "NEVER_MOVE", "NO_CONF", "NO_FEAR", "NO_SLEEP", "ONLY_ITEM", "RES_TELE", "UNIQUE"], hdice:"50", hside:"100", body_parts:(0, 0, 0, 0, 0, 0), desc:"A gigantic seething mass of flesh, Qlzqqlzuup changes colours in front of your eyes.  Pulsating first one colour then the next, it knows only it must bring help to protect itself. "),
    (id:824, name:"Flare, rider of bronze Moonth", ch:"B", color:15, speed:130, hp:"70d100", ac:100, alert:15, aaf:100, depth:79, rarity:5, weight:400000, exp:38500, blows:[(method:"HIT", effect:"HURT", dice:"15d15"), (method:"HIT", effect:"HURT", dice:"15d15"), (method:"HIT", effect:"HURT", dice:"15d15"), (method:"HIT", effect:"HURT", dice:"15d15")], spell_freq:4, spells:["BR_FIRE", "BR_TIME", "HEAL", "ROCKET", "SCARE", "S_THUNDERLORD", "TELE_LEVEL", "TELE_TO", "TPORT"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DROP_1D2", "DROP_4D2", "DROP_60", "DROP_90", "DROP_CORPSE", "DROP_GOOD", "DROP_SKELETON", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "MORTAL", "ONLY_ITEM", "OPEN_DOOR", "PET", "REGENERATE", "RES_TELE", "THUNDERLORD", "UNIQUE"], hdice:"70", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"A leader from afar, he has come with his eagle to help you in your battle. Having already saved his home, he now wants to save Arda! "),
