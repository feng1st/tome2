    (id:691, name:"Drolem", ch:"g", color:5, speed:120, hp:"30d100", ac:130, alert:30, aaf:25, depth:44, rarity:3, weight:40000, exp:12000, blows:[(method:"CLAW", effect:"HURT", dice:"3d10"), (method:"CLAW", effect:"HURT", dice:"3d10"), (method:"BITE", effect:"POISON", dice:"5d10"), (method:"BITE", effect:"POISON", dice:"5d10")], spell_freq:6, spells:["ARROW_3", "BLIND", "BR_POIS", "CONF", "SLOW"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ATTR_MULTI", "BASH_DOOR", "CAN_SWIM", "COLD_BLOOD", "DRAGON", "EMPTY_MIND", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "NONLIVING", "NO_CONF", "NO_CUT", "NO_FEAR", "NO_SLEEP", "OPEN_DOOR", "RES_TELE"], hdice:"30", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"A constructed dragon, the drolem has massive strength. Powerful spells weaved during its creation make it a fearsome adversary. Its eyes show little intelligence, but it has been instructed to destroy all it meets. "),
    (id:692, name:"Scatha the Worm", ch:"D", color:9, speed:120, hp:"22d100", ac:130, alert:70, aaf:30, depth:46, rarity:2, weight:210000, exp:17000, blows:[(method:"CLAW", effect:"HURT", dice:"4d10"), (method:"CLAW", effect:"HURT", dice:"4d10"), (method:"BITE", effect:"COLD", dice:"4d14"), (method:"BITE", effect:"COLD", dice:"4d14")], spell_freq:4, spells:["BR_COLD", "CAUSE_3", "CONF"], open_door:false, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_COLD", "MALE", "MOVE_BODY", "NO_CONF", "ONLY_ITEM", "POWERFUL", "SUSCEP_FIRE", "UNIQUE"], hdice:"22", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"An ancient and wise dragon, Scatha has grown clever over the long years. His scales are covered with frost, and his breath sends a shower of ice into the air. "),
