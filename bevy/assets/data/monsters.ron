    (id:844, name:"Vecna, the Emperor Lich", ch:"L", color:10, speed:130, hp:"80d100", ac:100, alert:0, aaf:100, depth:92, rarity:3, weight:1, exp:45000, blows:[(method:"HIT", effect:"EXP_80", dice:"7d12"), (method:"HIT", effect:"LOSE_DEX", dice:"7d12"), (method:"HIT", effect:"UN_POWER", dice:"7d12"), (method:"HIT", effect:"UN_POWER", dice:"7d12")], spell_freq:3, spells:["BA_FIRE", "BA_MANA", "BA_NETH", "BLIND", "BO_MANA", "BRAIN_SMASH", "CAUSE_4", "HAND_DOOM", "SCARE", "S_HI_DEMON", "S_HI_UNDEAD", "S_KIN", "S_MONSTERS", "TPORT"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:true, artifact_idx:0, artifact_chance:0, objs:(0, 50, 50, 0), flags:["BASH_DOOR", "CAN_SPEAK", "COLD_BLOOD", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_GOOD", "DROP_GREAT", "ESCORT", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "NO_CUT", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "RES_TELE", "SMART", "UNDEAD", "UNIQUE"], hdice:"80", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"The greatest of all undead sorcerers, even the gods once feared him.  This ancient shadow of death wilts every living thing it passes. "),
    (id:847, name:"Great Wyrm of Power", ch:"D", color:10, speed:130, hp:"111d111", ac:160, alert:70, aaf:40, depth:85, rarity:4, weight:220000, exp:47500, blows:[(method:"CLAW", effect:"HURT", dice:"8d12"), (method:"CLAW", effect:"HURT", dice:"8d12"), (method:"BITE", effect:"HURT", dice:"10d14"), (method:"BITE", effect:"HURT", dice:"10d14")], spell_freq:4, spells:["BR_ACID", "BR_CHAO", "BR_COLD", "BR_CONF", "BR_DARK", "BR_DISE", "BR_DISI", "BR_ELEC", "BR_FIRE", "BR_GRAV", "BR_INER", "BR_LITE", "BR_MANA", "BR_NETH", "BR_NEXU", "BR_PLAS", "BR_POIS", "BR_SHAR", "BR_SOUN", "BR_TIME", "BR_WALL", "S_DRAGON", "S_HI_DRAGON", "S_KIN"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["ATTR_MULTI", "AURA_COLD", "AURA_ELEC", "AURA_FIRE", "BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MOVE_BODY", "NO_CONF", "NO_CUT", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "REFLECTING", "RES_DISE", "RES_NETH", "RES_NEXU", "RES_PLAS", "RES_TELE"], hdice:"111", hside:"111", body_parts:(0, 1, 0, 6, 1, 0), desc:"The mightiest of all dragonkind, a great wyrm of power is seldom encountered in our world. It can crush stars with its might. "),
    (id:850, name:"Carcharoth, the Jaws of Thirst", ch:"C", color:8, speed:130, hp:"90d100", ac:110, alert:10, aaf:80, depth:94, rarity:1, weight:3400, exp:40000, blows:[(method:"CLAW", effect:"POISON", dice:"9d12"), (method:"CLAW", effect:"POISON", dice:"9d12"), (method:"BITE", effect:"FIRE", dice:"9d12"), (method:"BITE", effect:"FIRE", dice:"9d12")], spell_freq:3, spells:["BR_DARK", "BR_FIRE", "BR_NETH", "BR_POIS", "S_HOUND"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(30, 10, 60, 0), flags:["ANIMAL", "AURA_FIRE", "BASH_DOOR", "CAN_SPEAK", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_FIRE", "IM_POIS", "MALE", "MOVE_BODY", "ONLY_ITEM", "OPEN_DOOR", "SMART", "UNIQUE"], hdice:"90", hside:"100", body_parts:(0, 1, 0, 2, 1, 0), desc:"The first guard of Angband, Carcharoth, also known as 'The Red Maw', is the largest wolf to ever walk the earth. He is highly intelligent and a deadly opponent in combat. "),
    (id:853, name:"Huan, Wolfhound of the Valar", ch:"C", color:9, speed:130, hp:"90d100", ac:160, alert:10, aaf:50, depth:93, rarity:2, weight:3400, exp:40000, blows:[(method:"CLAW", effect:"COLD", dice:"9d12"), (method:"CLAW", effect:"COLD", dice:"9d12"), (method:"BITE", effect:"COLD", dice:"9d12"), (method:"BITE", effect:"COLD", dice:"9d12")], spell_freq:5, spells:["BR_COLD", "BR_LITE", "BR_SHAR", "BR_SOUN"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(30, 10, 60, 0), flags:["ANIMAL", "AURA_COLD", "BASH_DOOR", "CAN_SPEAK", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "IM_ACID", "IM_COLD", "IM_ELEC", "KILL_BODY", "MALE", "ONLY_ITEM", "OPEN_DOOR", "SMART", "UNIQUE"], hdice:"90", hside:"100", body_parts:(0, 1, 0, 2, 1, 0), desc:"The wolfhound of the Valar, Huan has served many masters in his time, from Celegorm son of Feanor to Beren son of Barahir: but now he runs wild and acknowledges no master save himself, as he hunts alone for his nemesis - Carcharoth, the terrible wolf of Angband. "),
    (id:856, name:"Gothmog, the High Captain of Balrogs", ch:"U", color:10, speed:130, hp:"120d100", ac:140, alert:0, aaf:100, depth:95, rarity:1, weight:17000, exp:43000, blows:[(method:"HIT", effect:"FIRE", dice:"9d12"), (method:"HIT", effect:"FIRE", dice:"9d12"), (method:"CRUSH", effect:"HURT", dice:"8d12"), (method:"TOUCH", effect:"UN_POWER", dice:"0d0")], spell_freq:3, spells:["BLIND", "BR_FIRE", "CONF", "SCARE", "S_HI_DEMON", "S_HI_UNDEAD", "S_KIN"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:true, artifact_idx:123, artifact_chance:50, objs:(0, 100, 0, 0), flags:["AURA_FIRE", "BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DEMON", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_GOOD", "DROP_GREAT", "ESCORT", "ESCORTS", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_ELEC", "IM_FIRE", "KILL_WALL", "MALE", "MOVE_BODY", "NONLIVING", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "UNIQUE"], hdice:"120", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"Gothmog is the Chief Balrog in Morgoth's personal guard. He is renowned for slaying three High Kings of the Noldor Elves, and he has never been defeated in combat. With his whip of flame and awesome fiery breath he saved his master from Ungoliant's rage. "),
    (id:858, name:"Sarko, rider of gold Foronth", ch:"B", color:11, speed:145, hp:"99d111", ac:165, alert:0, aaf:100, depth:97, rarity:6, weight:420000, exp:65000, blows:[(method:"HIT", effect:"HURT", dice:"12d12"), (method:"HIT", effect:"HURT", dice:"12d12"), (method:"HIT", effect:"FIRE", dice:"12d12"), (method:"HIT", effect:"FIRE", dice:"12d12")], spell_freq:4, spells:["BR_FIRE", "BR_TIME", "S_THUNDERLORD", "TELE_AWAY", "TELE_TO", "TPORT"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["ATTR_MULTI", "AURA_ELEC", "AURA_FIRE", "BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CHOSEN", "DROP_CORPSE", "DROP_GOOD", "DROP_GREAT", "FEMALE", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "HAS_LITE", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MORTAL", "MOVE_BODY", "ONLY_ITEM", "OPEN_DOOR", "PET", "POWERFUL", "REFLECTING", "REGENERATE", "RES_TELE", "SMART", "THUNDERLORD", "UNIQUE"], hdice:"99", hside:"111", body_parts:(1, 1, 1, 2, 1, 1), desc:"Foronth is the first Eagle queen, and Sarko the first to discover the Firebirds, the ancestor of the Thunderlord eagles. She will try to help you! "),
    (id:860, name:"Sauron, the Sorcerer", ch:"p", color:10, speed:130, hp:"100d225", ac:160, alert:0, aaf:100, depth:99, rarity:1, weight:2300, exp:50000, blows:[(method:"HIT", effect:"UN_BONUS", dice:"10d12"), (method:"HIT", effect:"UN_BONUS", dice:"10d12"), (method:"HIT", effect:"UN_POWER", dice:"8d12"), (method:"HIT", effect:"UN_POWER", dice:"8d12")], spell_freq:2, spells:["BA_CHAO", "BA_DARK", "BA_FIRE", "BA_MANA", "BA_NETH", "BA_WATE", "BLIND", "BO_ICEE", "BO_MANA", "BO_PLAS", "BRAIN_SMASH", "CAUSE_4", "CONF", "FORGET", "HAND_DOOM", "SCARE", "S_HI_DEMON", "S_HI_DRAGON", "S_HI_UNDEAD", "S_MONSTERS", "S_UNIQUE", "S_WRAITH", "TELE_LEVEL", "TPORT"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 100, 0), flags:["BASH_DOOR", "CAN_SPEAK", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_GOOD", "DROP_GREAT", "EVIL", "FORCE_DEPTH", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "MOVE_BODY", "NO_CONF", "NO_FEAR", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "REFLECTING", "REGENERATE", "RES_TELE", "SMART", "UNIQUE"], hdice:"100", hside:"225", body_parts:(1, 1, 1, 2, 1, 1), desc:"Mighty in spells and enchantments, he created the One Ring. His eyes glow with power and with his gaze he seeks to destroy your soul. He has many servants, and rarely fights without them. "),
    (id:861, name:"DarkGod, the Mighty Coder of Hell", ch:"P", color:14, speed:155, hp:"180d100", ac:175, alert:0, aaf:111, depth:127, rarity:1, weight:1600, exp:66666, blows:[(method:"GAZE", effect:"EAT_GOLD", dice:"20d10"), (method:"HIT", effect:"SHATTER", dice:"20d10"), (method:"BITE", effect:"LOSE_ALL", dice:"10d12"), (method:"TOUCH", effect:"UN_POWER", dice:"0d0")], spell_freq:2, spells:["BA_CHAO", "BRAIN_SMASH", "BR_CHAO", "BR_DISI", "BR_MANA", "BR_NETH", "BR_NUKE", "BR_POIS", "FORGET", "HAND_DOOM", "HASTE", "HEAL", "ROCKET", "S_BUG", "S_HI_DEMON", "S_HI_DRAGON", "S_HI_UNDEAD", "S_RNG", "S_THUNDERLORD", "TELE_TO", "TPORT"], open_door:false, bash_door:false, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(20, 20, 20, 20), flags:["ATTR_ANY", "ATTR_MULTI", "AURA_COLD", "AURA_ELEC", "AURA_FIRE", "CAN_FLY", "CAN_SPEAK", "CAN_SWIM", "DG_CURSE", "DROP_1D2", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "DROP_GREAT", "DROP_SKELETON", "EVIL", "FORCE_MAXHP", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "INVISIBLE", "JOKEANGBAND", "KILL_BODY", "KILL_WALL", "MALE", "MORTAL", "NO_CONF", "NO_FEAR", "NO_STUN", "ONLY_ITEM", "POWERFUL", "REFLECTING", "REGENERATE", "RES_NETH", "RES_TELE", "SMART", "UNIQUE", "WEIRD_MIND", "WYRM_PROTECT"], hdice:"180", hside:"100", body_parts:(2, 0, 2, 6, 1, 1), desc:"He is the master of coding; none can match his skill. He created the Variant Maintainer, the RNGs, and the software bugs. Bull Gates is nothing next to him. Do not think that since he loves the novels of Tolkien he is to be ignored! He wishes to translate your soul into assembler, the one hitch being that he must kill you first. If you encounter him, pray your deity holds you in good stead. "),
    (id:862, name:"Morgoth, Lord of Darkness", ch:"P", color:8, speed:140, hp:"200d150", ac:150, alert:0, aaf:100, depth:100, rarity:1, weight:200000, exp:60000, blows:[(method:"HIT", effect:"SHATTER", dice:"24d10"), (method:"HIT", effect:"SHATTER", dice:"24d10"), (method:"HIT", effect:"LOSE_ALL", dice:"10d12"), (method:"TOUCH", effect:"UN_POWER", dice:"0d0")], spell_freq:3, spells:["BA_CHAO", "BA_DARK", "BA_MANA", "BA_NETH", "BO_MANA", "BRAIN_SMASH", "BR_DISI", "BR_NETH", "HAND_DOOM", "ROCKET", "S_HI_DEMON", "S_HI_DRAGON", "S_HI_UNDEAD", "S_MONSTERS", "S_UNIQUE", "S_WRAITH"], open_door:false, bash_door:false, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 100, 0, 0), flags:["AURA_COLD", "CAN_SPEAK", "DROP_1D2", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CHOSEN", "DROP_GOOD", "DROP_GREAT", "EVIL", "FORCE_DEPTH", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "KILL_WALL", "MALE", "MOVE_BODY", "NO_CONF", "NO_FEAR", "NO_SLEEP", "NO_STUN", "ONLY_ITEM", "POWERFUL", "REGENERATE", "RES_NETH", "RES_TELE", "SMART", "UNIQUE"], hdice:"200", hside:"150", body_parts:(1, 1, 1, 2, 1, 1), desc:"He was the most powerful of the Valar, the equal of Manwe. He is the Master of the Pits of Angband. His figure is like a black mountain crowned with Lightning. He rages with everlasting anger, his body scarred by Fingolfin's eight mighty wounds. He can never rest from his pain, but seeks forever to dominate all that is light and good in the world. He is the origin of man's fear of darkness and created many foul creatures with his evil powers. Orcs, Dragons, and Trolls are his most foul corruptions, causing much pain and suffering in the world to please him. His disgusting visage, twisted with evil, is crowned with iron, the two remaining Silmarils forever burning him. Grond, the mighty Hammer of the Underworld, cries defiance as he strides towards you to crush you to a pulp! "),
    (id:863, name:"Human Warrior", ch:"p", color:7, speed:110, hp:"9d8", ac:10, alert:0, aaf:10, depth:0, rarity:20, weight:1700, exp:0, blows:[(method:"HIT", effect:"HURT", dice:"5d8")], spell_freq:0, spells:[], open_door:true, bash_door:true, never_move:false, unique:false, friends:true, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["BASH_DOOR", "DROP_1D2", "DROP_CORPSE", "FRIENDS", "HAS_LITE", "MALE", "MORTAL", "ONLY_GOLD", "OPEN_DOOR", "PET", "WILD_ONLY"], hdice:"9", hside:"8", body_parts:(1, 1, 1, 2, 1, 1), desc:"They are used as the main assault force of the human kings. They will help you in some quests. "),
