    (id:783, name:"Great Wyrm of Chaos", ch:"D", color:10, speed:120, hp:"60d100", ac:170, alert:100, aaf:40, depth:75, rarity:2, weight:190000, exp:29000, blows:[(method:"CLAW", effect:"HURT", dice:"5d12"), (method:"CLAW", effect:"HURT", dice:"5d12"), (method:"BITE", effect:"HURT", dice:"7d14"), (method:"BITE", effect:"HURT", dice:"7d14")], spell_freq:4, spells:["BLIND", "BR_CHAO", "BR_DISE", "CONF", "SCARE", "S_DRAGON", "S_HI_DRAGON"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["ATTR_ANY", "ATTR_MULTI", "BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "MOVE_BODY", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "POWERFUL", "RES_DISE"], hdice:"60", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"A massive dragon of changing form. As you watch, it appears first fair and then foul. Its body is twisted by chaotic forces as it strives to stay real. Its very existence distorts the universe around it. "),
    (id:784, name:"Great Wyrm of Law", ch:"D", color:14, speed:120, hp:"60d100", ac:170, alert:100, aaf:40, depth:75, rarity:2, weight:190000, exp:29000, blows:[(method:"CLAW", effect:"HURT", dice:"5d12"), (method:"CLAW", effect:"HURT", dice:"5d12"), (method:"BITE", effect:"HURT", dice:"7d14"), (method:"BITE", effect:"HURT", dice:"7d14")], spell_freq:4, spells:["BLIND", "BR_SHAR", "BR_SOUN", "CONF", "SCARE", "S_DRAGON", "S_HI_DRAGON"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["ATTR_MULTI", "BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "MOVE_BODY", "NO_CUT", "NO_SLEEP", "NO_STUN", "ONLY_ITEM", "POWERFUL"], hdice:"60", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"A massive dragon of powerful intellect. It seeks to dominate the universe and despises all other life. It sees all who do not obey it as mere insects to be crushed underfoot. "),
    (id:785, name:"Great Wyrm of Balance", ch:"D", color:10, speed:120, hp:"70d100", ac:170, alert:100, aaf:40, depth:80, rarity:2, weight:190000, exp:31000, blows:[(method:"CLAW", effect:"HURT", dice:"6d12"), (method:"CLAW", effect:"HURT", dice:"6d12"), (method:"BITE", effect:"HURT", dice:"8d14"), (method:"BITE", effect:"HURT", dice:"8d14")], spell_freq:4, spells:["BLIND", "BR_CHAO", "BR_DISE", "BR_SHAR", "BR_SOUN", "CONF", "SCARE", "S_DRAGON", "S_HI_DRAGON"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["ATTR_MULTI", "BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "MOVE_BODY", "NO_CONF", "NO_CUT", "NO_SLEEP", "NO_STUN", "ONLY_ITEM", "POWERFUL", "RES_DISE"], hdice:"70", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"A massive dragon, it is thousands of years old and seeks to maintain the Cosmic Balance. It sees you as an upstart troublemaker without the wisdom to control your actions. "),
    (id:787, name:"Gelugon", ch:"U", color:1, speed:130, hp:"45d100", ac:100, alert:80, aaf:20, depth:69, rarity:3, weight:1, exp:14000, blows:[(method:"CLAW", effect:"COLD", dice:"6d10"), (method:"CLAW", effect:"COLD", dice:"6d10"), (method:"BITE", effect:"COLD", dice:"9d9"), (method:"HIT", effect:"PARALYZE", dice:"8d8")], spell_freq:6, spells:["BA_COLD", "BO_ICEE", "BR_COLD", "BR_SHAR", "HOLD", "SCARE", "SLOW", "S_HI_DEMON"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(20, 60, 20, 0), flags:["BASH_DOOR", "CAN_FLY", "DEMON", "DROP_4D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "NONLIVING", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "REGENERATE"], hdice:"45", hside:"100", body_parts:(2, 1, 2, 0, 0, 1), desc:"This demon from the ice planes is a truly terrifying sight.  It has an extremely large, insect-like body towering a full twelve feet tall, with great claws on its hands and pincers on its mouth, and its head bulges with great multi-faceted eyes.  Its tail is covered with razor-sharp spikes. "),
    (id:789, name:"Trone, the Rebel Thunderlord", ch:"B", color:8, speed:130, hp:"80d100", ac:120, alert:80, aaf:20, depth:72, rarity:2, weight:400000, exp:45000, blows:[(method:"HIT", effect:"HURT", dice:"12d10"), (method:"HIT", effect:"HURT", dice:"12d10"), (method:"CHARGE", effect:"HURT", dice:"10d10"), (method:"CHARGE", effect:"HURT", dice:"10d10")], spell_freq:4, spells:["BO_MANA", "BR_FIRE", "BR_TIME", "SCARE", "S_THUNDERLORD", "TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CHOSEN", "DROP_GOOD", "DROP_GREAT", "EVIL", "FORCE_MAXHP", "HAS_LITE", "IM_COLD", "IM_FIRE", "IM_POIS", "MALE", "MORTAL", "ONLY_ITEM", "OPEN_DOOR", "REGENERATE", "RES_TELE", "SMART", "SPECIAL_GENE", "THUNDERLORD", "UNIQUE"], hdice:"80", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"As the Thunderlords came from afar to help the elves, Trone and his rebel wing came to defend Morgoth! He is an evil and powerful Thunderlord. "),
    (id:790, name:"Great Wyrm of Many Colours", ch:"D", color:10, speed:120, hp:"70d100", ac:170, alert:255, aaf:40, depth:80, rarity:2, weight:190000, exp:31000, blows:[(method:"CLAW", effect:"HURT", dice:"6d12"), (method:"CLAW", effect:"HURT", dice:"6d12"), (method:"CLAW", effect:"HURT", dice:"8d14"), (method:"BITE", effect:"HURT", dice:"8d14")], spell_freq:4, spells:["BLIND", "BR_ACID", "BR_COLD", "BR_ELEC", "BR_FIRE", "BR_POIS", "CONF", "SCARE"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["ATTR_MULTI", "AURA_COLD", "AURA_ELEC", "AURA_FIRE", "BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MOVE_BODY", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "POWERFUL", "RES_TELE"], hdice:"70", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"A huge dragon whose scales shimmer in myriad hues. "),
    (id:791, name:"Marda, rider of gold Laronth", ch:"B", color:11, speed:130, hp:"100d85", ac:100, alert:50, aaf:100, depth:75, rarity:6, weight:420000, exp:35000, blows:[(method:"HIT", effect:"HURT", dice:"12d15"), (method:"HIT", effect:"HURT", dice:"12d15"), (method:"HIT", effect:"HURT", dice:"12d15"), (method:"HIT", effect:"HURT", dice:"12d15")], spell_freq:4, spells:["BA_MANA", "BLIND", "BLINK", "BR_FIRE", "SCARE", "S_THUNDERLORD", "TELE_AWAY", "TELE_TO", "TPORT"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:26, artifact_chance:50, objs:(50, 50, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DROP_1D2", "DROP_4D2", "DROP_60", "DROP_90", "DROP_CHOSEN", "DROP_CORPSE", "DROP_GOOD", "DROP_SKELETON", "EVIL", "FEMALE", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_ELEC", "IM_POIS", "MORTAL", "ONLY_ITEM", "OPEN_DOOR", "REGENERATE", "RES_TELE", "SMART", "THUNDERLORD", "UNIQUE"], hdice:"100", hside:"85", body_parts:(1, 1, 1, 2, 1, 1), desc:"Former leader among the Thunderlords, she and Trone have fallen under the control of Morgoth. Laronth, her eagle, can summon Thunderlords to her aid. "),
    (id:792, name:"Tselakus, the Dreadlord", ch:"G", color:12, speed:130, hp:"65d100", ac:150, alert:10, aaf:20, depth:68, rarity:2, weight:1000, exp:35000, blows:[(method:"HIT", effect:"HURT", dice:"10d10"), (method:"HIT", effect:"HURT", dice:"10d10"), (method:"HIT", effect:"LOSE_STR", dice:"4d6"), (method:"HIT", effect:"LOSE_STR", dice:"4d6")], spell_freq:3, spells:["BA_DARK", "BA_NETH", "BLIND", "CONF", "HOLD", "S_HI_UNDEAD", "S_KIN", "S_WRAITH"], open_door:false, bash_door:false, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 80, 20, 0), flags:["AURA_COLD", "CAN_FLY", "CAN_SPEAK", "COLD_BLOOD", "DROP_3D2", "DROP_4D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "IM_POIS", "INVISIBLE", "MALE", "NO_CONF", "NO_CUT", "NO_SLEEP", "NO_STUN", "ONLY_ITEM", "PASS_WALL", "UNDEAD", "UNIQUE"], hdice:"65", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"This huge affront to existence twists and tears at the fabric of space. Darkness itself recoils from the touch of Tselakus as he leaves a trail of death and destruction. Mighty claws rend reality as he annihilates all in his path to your soul! "),
    (id:793, name:"Sky Drake", ch:"D", color:14, speed:130, hp:"60d100", ac:200, alert:255, aaf:40, depth:77, rarity:2, weight:220000, exp:40000, blows:[(method:"CLAW", effect:"HURT", dice:"6d12"), (method:"CLAW", effect:"HURT", dice:"6d12"), (method:"BITE", effect:"ELEC", dice:"8d14"), (method:"BITE", effect:"ELEC", dice:"8d14")], spell_freq:4, spells:["BLIND", "BR_ELEC", "BR_GRAV", "BR_LITE", "SCARE", "S_DRAGON", "S_HI_DRAGON"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["ATTR_MULTI", "AURA_COLD", "AURA_ELEC", "BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_ELEC", "MOVE_BODY", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "POWERFUL", "RES_TELE"], hdice:"60", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"The mightiest elemental dragon of air, it can destroy you with ease. "),
    (id:795, name:"Horned Reaper", ch:"U", color:14, speed:130, hp:"50d100", ac:120, alert:80, aaf:40, depth:72, rarity:3, weight:1, exp:18000, blows:[(method:"HIT", effect:"HURT", dice:"11d11"), (method:"HIT", effect:"HURT", dice:"11d11"), (method:"HIT", effect:"HURT", dice:"11d11"), (method:"HIT", effect:"HURT", dice:"11d11")], spell_freq:5, spells:["HASTE", "SCARE", "SLOW", "S_HI_DEMON"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 100, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "DEMON", "DROP_2D2", "DROP_4D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "KILL_BODY", "NONLIVING", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "REGENERATE"], hdice:"50", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"A giant humanoid demon wielding a massive, heavy and sharp scythe.  Feared by foes and friends alike when it flies into one of its berserk rages, the Horned Reaper will cut down anything in its path between it and you - even the minions it has just summoned. "),
    (id:798, name:"Black reaver", ch:"L", color:8, speed:120, hp:"50d100", ac:170, alert:50, aaf:20, depth:74, rarity:3, weight:1900, exp:23000, blows:[(method:"HIT", effect:"UN_BONUS", dice:"6d8"), (method:"HIT", effect:"UN_BONUS", dice:"6d8"), (method:"HIT", effect:"LOSE_STR", dice:"4d6"), (method:"HIT", effect:"LOSE_STR", dice:"4d6")], spell_freq:3, spells:["BA_MANA", "BA_NETH", "BLIND", "BRAIN_SMASH", "CAUSE_3", "CAUSE_4", "CONF", "DRAIN_MANA", "HOLD", "S_UNDEAD", "TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 60, 40, 0), flags:["BASH_DOOR", "CAN_SWIM", "COLD_BLOOD", "DROP_1D2", "DROP_2D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "IM_POIS", "KILL_WALL", "MORTAL", "NO_CONF", "NO_CUT", "NO_FEAR", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "RES_TELE", "SMART", "UNDEAD"], hdice:"50", hside:"100", body_parts:(0, 0, 0, 0, 0, 0), desc:"A humanoid form,  black as night, advancing steadily and unstoppably, even the very rock of the dungeon cannot prevent it reaching you. "),
    (id:799, name:"Master mindcrafter", ch:"p", color:11, speed:120, hp:"80d10", ac:60, alert:10, aaf:20, depth:40, rarity:2, weight:1700, exp:2000, blows:[(method:"HIT", effect:"HURT", dice:"4d5"), (method:"HIT", effect:"HURT", dice:"4d5"), (method:"HIT", effect:"HURT", dice:"4d5")], spell_freq:2, spells:["BA_COLD", "BA_FIRE", "BLIND", "BLINK", "BO_NETH", "BRAIN_SMASH", "CONF", "HEAL", "HOLD", "MIND_BLAST", "SCARE", "S_MONSTERS", "TELE_AWAY", "TPORT"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(20, 40, 40, 0), flags:["BASH_DOOR", "DROP_4D2", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "MOVE_BODY", "NO_CONF", "NO_FEAR", "NO_SLEEP", "NO_STUN", "ONLY_ITEM", "SMART", "TAKE_ITEM"], hdice:"80", hside:"10", body_parts:(1, 1, 1, 2, 1, 1), desc:"A mindcrafter of the highest order.  Powerful and evil, and a dangerous enemy: a master of mind over matter, of his own mind, and of the minds of others, who slavishly follow him into battle when he calls them."),
    (id:800, name:"Greater demonic quylthulg", ch:"Q", color:12, speed:120, hp:"15d100", ac:1, alert:0, aaf:20, depth:71, rarity:2, weight:5000, exp:10500, blows:[], spell_freq:2, spells:["BLINK", "S_HI_DEMON", "TELE_TO"], open_door:false, bash_door:false, never_move:true, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "EMPTY_MIND", "FORCE_MAXHP", "FORCE_SLEEP", "INVISIBLE", "NEVER_BLOW", "NEVER_MOVE", "NO_CONF", "NO_FEAR", "NO_SLEEP", "RES_TELE"], hdice:"15", hside:"100", body_parts:(0, 0, 0, 0, 0, 0), desc:"A massive pulsating mound of flesh, glowing with an inner hellish light. "),
