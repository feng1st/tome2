    (id:754, name:"The Lernaean Hydra", ch:"M", color:10, speed:120, hp:"45d100", ac:140, alert:20, aaf:20, depth:55, rarity:2, weight:13000, exp:20000, blows:[(method:"BITE", effect:"POISON", dice:"8d6"), (method:"BITE", effect:"POISON", dice:"8d6"), (method:"BITE", effect:"FIRE", dice:"12d6"), (method:"BITE", effect:"FIRE", dice:"12d6")], spell_freq:3, spells:["BA_FIRE", "BA_POIS", "BO_FIRE", "BO_PLAS", "BR_FIRE", "BR_POIS", "SCARE", "S_HYDRA", "S_KIN"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "BASH_DOOR", "CAN_SWIM", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "FORCE_MAXHP", "FORCE_SLEEP", "IM_FIRE", "IM_POIS", "KILL_BODY", "MORTAL", "NO_CONF", "NO_STUN", "ONLY_GOLD", "OPEN_DOOR", "POWERFUL", "REGENERATE", "SMART", "SUSCEP_COLD", "UNIQUE", "WILD_SHORE", "WILD_TOO"], hdice:"45", hside:"100", body_parts:(0, 1, 0, 2, 2, 0), desc:"A massive legendary hydra. It has twelve powerful heads. Its many eyes stare at you as clouds of smoke and poisonous vapour rise from its seething form.  It grows new heads as fast as you chop them off. "),
    (id:755, name:"Thuringwethil, the Vampire Messenger", ch:"V", color:10, speed:130, hp:"50d100", ac:145, alert:10, aaf:20, depth:67, rarity:3, weight:1500, exp:23000, blows:[(method:"BITE", effect:"EXP_80", dice:"6d6"), (method:"BITE", effect:"EXP_80", dice:"6d6"), (method:"HIT", effect:"CONFUSE", dice:"6d6"), (method:"HIT", effect:"CONFUSE", dice:"6d6")], spell_freq:3, spells:["BA_NETH", "BLIND", "BRAIN_SMASH", "CAUSE_3", "CAUSE_4", "DRAIN_MANA", "HOLD", "SCARE", "S_HI_UNDEAD", "S_KIN"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 50, 50, 0), flags:["BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "COLD_BLOOD", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_GOOD", "EVIL", "FEMALE", "FORCE_MAXHP", "FORCE_SLEEP", "HURT_LITE", "IM_COLD", "IM_POIS", "NO_CONF", "NO_CUT", "NO_SLEEP", "NO_STUN", "ONLY_ITEM", "OPEN_DOOR", "REGENERATE", "RES_TELE", "SMART", "SPECIAL_GENE", "UNDEAD", "UNIQUE"], hdice:"50", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"Chief messenger between Sauron and Morgoth, she is the most deadly of her vampire race on Middle-earth.  At first she is charming to meet, but her wings and eyes give away her true form. "),
    (id:756, name:"Great Hell Wyrm", ch:"D", color:4, speed:120, hp:"50d100", ac:150, alert:80, aaf:30, depth:67, rarity:2, weight:190000, exp:23000, blows:[(method:"CLAW", effect:"HURT", dice:"4d12"), (method:"CLAW", effect:"HURT", dice:"4d12"), (method:"BITE", effect:"FIRE", dice:"6d14"), (method:"BITE", effect:"FIRE", dice:"6d14")], spell_freq:4, spells:["BLIND", "BR_FIRE", "CONF", "SCARE"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["ATTR_MULTI", "AURA_FIRE", "BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_FIRE", "MOVE_BODY", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "POWERFUL", "SUSCEP_COLD"], hdice:"50", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"A vast dragon of immense power. Fire leaps continuously from its huge form. The air around it scalds you. Its slightest glance burns you, and you realise how truly insignificant you are. "),
    (id:759, name:"Draconic quylthulg", ch:"Q", color:5, speed:120, hp:"48d10", ac:1, alert:0, aaf:20, depth:45, rarity:1, weight:3000, exp:3000, blows:[], spell_freq:2, spells:["BLINK", "S_DRAGON", "TPORT"], open_door:false, bash_door:false, never_move:true, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "EMPTY_MIND", "FORCE_MAXHP", "FORCE_SLEEP", "INVISIBLE", "NEVER_BLOW", "NEVER_MOVE", "NO_CONF", "NO_FEAR", "NO_SLEEP"], hdice:"48", hside:"10", body_parts:(0, 0, 0, 0, 0, 0), desc:"It looks like it was once a dragon corpse, now deeply infected with magical bacteria that make it pulse in a foul and degrading way. "),
    (id:762, name:"Fundin Bluecloak", ch:"h", color:14, speed:130, hp:"50d100", ac:195, alert:10, aaf:25, depth:56, rarity:2, weight:1400, exp:20000, blows:[(method:"HIT", effect:"HURT", dice:"10d10"), (method:"HIT", effect:"HURT", dice:"8d6"), (method:"HIT", effect:"HURT", dice:"8d6"), (method:"HIT", effect:"HURT", dice:"8d6")], spell_freq:4, spells:["BLIND", "BRAIN_SMASH", "CAUSE_3", "CAUSE_4", "CONF", "FORGET", "HEAL", "SCARE", "S_ANIMALS", "S_MONSTERS"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 80, 20, 0), flags:["BASH_DOOR", "CAN_SPEAK", "DROP_1D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "MORTAL", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "PET", "UNIQUE"], hdice:"50", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"He is one of the greatest dwarven priests to walk the earth. Fundin has earned a high position in the church, and his skill with both weapon and spell only justify his position further. His combination of both dwarven strength and priestly wisdom are a true match for any adventurer. "),
    (id:763, name:"Bile Demon", ch:"U", color:12, speed:120, hp:"35d100", ac:90, alert:80, aaf:40, depth:61, rarity:2, weight:1, exp:12000, blows:[(method:"HIT", effect:"HURT", dice:"8d8"), (method:"HIT", effect:"HURT", dice:"8d8"), (method:"CRUSH", effect:"ACID", dice:"9d9"), (method:"CRUSH", effect:"ACID", dice:"9d9")], spell_freq:6, spells:["ARROW_4", "BLIND", "BR_ACID", "BR_POIS", "CONF", "S_DEMON"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(30, 70, 0, 0), flags:["BASH_DOOR", "DEMON", "DROP_3D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_ACID", "IM_POIS", "NONLIVING", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "POWERFUL"], hdice:"35", hside:"100", body_parts:(1, 0, 1, 2, 1, 0), desc:"It's big.  It's fat.  It's red.  It's ugly.  It's got a severe attack of highly poisonous flatulence.  And its insides are corrosive.  All of which go together to make the single most repulsive sight - and smell - you have ever experienced. "),
    (id:764, name:"Uriel, Angel of Fire", ch:"A", color:12, speed:130, hp:"55d100", ac:160, alert:10, aaf:40, depth:61, rarity:3, weight:3400, exp:25000, blows:[(method:"HIT", effect:"FIRE", dice:"4d12"), (method:"HIT", effect:"FIRE", dice:"4d12"), (method:"HIT", effect:"HURT", dice:"10d10"), (method:"HIT", effect:"HURT", dice:"10d10")], spell_freq:2, spells:["BA_FIRE", "BLIND", "BO_FIRE", "BO_MANA", "BR_FIRE", "BR_PLAS", "S_ANGEL", "TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 100, 0, 0), flags:["AURA_FIRE", "BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DROP_3D2", "DROP_4D2", "DROP_GOOD", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "HAS_LITE", "IM_ACID", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "MOVE_BODY", "NO_FEAR", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "REFLECTING", "RES_TELE", "SMART", "SUSCEP_COLD", "TAKE_ITEM", "UNIQUE"], hdice:"55", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"A creature of godly appearance. You dare not challenge Uriel's supremacy. Those who stood against him before are but a memory, cremated by his mastery of elemental fire."),
    (id:765, name:"Azriel, Angel of Death", ch:"A", color:8, speed:130, hp:"60d100", ac:170, alert:10, aaf:40, depth:62, rarity:3, weight:3400, exp:30000, blows:[(method:"HIT", effect:"EXP_80", dice:"10d5"), (method:"HIT", effect:"EXP_80", dice:"10d5"), (method:"HIT", effect:"HURT", dice:"10d10"), (method:"HIT", effect:"HURT", dice:"10d10")], spell_freq:2, spells:["BA_NETH", "BLIND", "BO_MANA", "BO_NETH", "BR_NETH", "S_ANGEL", "TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 100, 0, 0), flags:["AURA_COLD", "BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DROP_3D2", "DROP_4D2", "DROP_GOOD", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "MOVE_BODY", "NO_FEAR", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "REFLECTING", "RES_NETH", "RES_TELE", "SMART", "TAKE_ITEM", "UNIQUE"], hdice:"60", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"Azriel commands awesome power, his visage holy enough to shrivel your soul. You shriek with disbelief as his mastery of death draws you to your grave. It is truly beyond all but the mightiest of warriors to stand against him and live. "),
    (id:766, name:"Ancalagon the Black", ch:"D", color:8, speed:140, hp:"180d100", ac:170, alert:70, aaf:40, depth:90, rarity:1, weight:330000, exp:60000, blows:[(method:"CLAW", effect:"HURT", dice:"10d12"), (method:"CLAW", effect:"HURT", dice:"10d12"), (method:"BITE", effect:"HURT", dice:"10d14"), (method:"BITE", effect:"HURT", dice:"10d14")], spell_freq:3, spells:["BR_ACID", "BR_DISI", "BR_FIRE", "BR_TIME", "BR_WALL", "S_HI_DRAGON", "S_KIN"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:true, artifact_idx:0, artifact_chance:0, objs:(60, 40, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "DROP_GREAT", "ESCORT", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "MOVE_BODY", "NO_CONF", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "UNIQUE"], hdice:"180", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"\"Rushing Jaws\" is his name, and death is his game; the greatest and most terrible of all dragonkind, his power dismayed even the Valar for a time. "),
    (id:768, name:"Nightwalker", ch:"W", color:8, speed:130, hp:"80d70", ac:175, alert:10, aaf:20, depth:73, rarity:3, weight:75000, exp:20000, blows:[(method:"HIT", effect:"UN_BONUS", dice:"10d10"), (method:"HIT", effect:"UN_BONUS", dice:"10d10"), (method:"HIT", effect:"UN_BONUS", dice:"7d7"), (method:"HIT", effect:"UN_BONUS", dice:"7d7")], spell_freq:4, spells:["BA_NETH", "BLIND", "BO_MANA", "BO_NETH", "BRAIN_SMASH", "SCARE", "S_UNDEAD"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(30, 0, 70, 0), flags:["BASH_DOOR", "CAN_SWIM", "COLD_BLOOD", "DROP_4D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HURT_LITE", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "NO_CONF", "NO_CUT", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "RES_TELE", "SMART", "UNDEAD"], hdice:"80", hside:"70", body_parts:(1, 1, 1, 2, 1, 1), desc:"A huge giant garbed in black, more massive than a titan and stronger than a dragon. With terrible blows, it breaks your armour from your back, leaving you defenceless against its evil wrath. It can smell your fear, and you in turn smell the awful stench of death as this ghastly figure strides towards you menacingly. "),
    (id:769, name:"Gabriel, the Messenger", ch:"A", color:1, speed:130, hp:"75d100", ac:180, alert:10, aaf:40, depth:64, rarity:3, weight:3500, exp:35000, blows:[(method:"HIT", effect:"UN_BONUS", dice:"6d8"), (method:"HIT", effect:"FIRE", dice:"6d8"), (method:"HIT", effect:"BLIND", dice:"10d10"), (method:"HIT", effect:"BLIND", dice:"10d10")], spell_freq:2, spells:["BLIND", "BO_MANA", "S_ANGEL", "S_KIN", "TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:true, artifact_idx:0, artifact_chance:0, objs:(0, 40, 60, 0), flags:["AURA_ELEC", "BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DROP_3D2", "DROP_4D2", "DROP_GOOD", "ESCORT", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "MOVE_BODY", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "REFLECTING", "RES_TELE", "SMART", "TAKE_ITEM", "UNIQUE"], hdice:"75", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"Commanding a legion of angels, Gabriel will destroy you for your sins. He will crush you like the pitiful insignificant being he sees you to be. Your very soul will be taken into judgement by his supreme authority as he cleanses the world of evil. "),
    (id:771, name:"Saruman of Many Colours", ch:"p", color:10, speed:120, hp:"70d100", ac:100, alert:0, aaf:100, depth:60, rarity:1, weight:1600, exp:35000, blows:[(method:"HIT", effect:"UN_BONUS", dice:"6d8"), (method:"HIT", effect:"UN_BONUS", dice:"6d8"), (method:"HIT", effect:"HURT", dice:"5d5"), (method:"HIT", effect:"HURT", dice:"5d5")], spell_freq:2, spells:["BA_ACID", "BA_CHAO", "BA_COLD", "BA_FIRE", "BA_WATE", "BLIND", "BO_ICEE", "BO_MANA", "CAUSE_4", "CONF", "FORGET", "HASTE", "HEAL", "MIND_BLAST", "SCARE", "S_ANIMALS", "S_DEMON", "S_HI_DRAGON", "S_UNDEAD", "TELE_AWAY", "TPORT"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:202, artifact_chance:30, objs:(0, 0, 100, 0), flags:["ATTR_MULTI", "BASH_DOOR", "CAN_SPEAK", "DROP_2D2", "DROP_3D2", "DROP_4D2", "DROP_CHOSEN", "DROP_GOOD", "DROP_GREAT", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "ONLY_ITEM", "OPEN_DOOR", "REFLECTING", "RES_TELE", "SMART", "UNIQUE"], hdice:"70", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"Originally known as the White, Saruman fell prey to Sauron's wiles. He searches forever for the One Ring, to become a mighty Sorcerer-King of the world. "),
    (id:772, name:"Harowen the Black Hand", ch:"p", color:14, speed:140, hp:"25d100", ac:36, alert:0, aaf:30, depth:51, rarity:3, weight:1, exp:20000, blows:[(method:"TOUCH", effect:"EAT_GOLD", dice:"5d5"), (method:"TOUCH", effect:"EAT_ITEM", dice:"5d5"), (method:"HIT", effect:"BLIND", dice:"10d5"), (method:"HIT", effect:"POISON", dice:"8d5")], spell_freq:6, spells:["TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(90, 10, 0, 0), flags:["BASH_DOOR", "CAN_SPEAK", "DROP_1D2", "DROP_4D2", "DROP_GOOD", "FORCE_MAXHP", "FORCE_SLEEP", "IM_POIS", "MALE", "MOVE_BODY", "ONLY_ITEM", "OPEN_DOOR", "SMART", "TAKE_ITEM", "UNIQUE"], hdice:"25", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"He is a master of disguise, an expert of stealth, a genius at traps, and moves with blinding speed. Check your pockets! "),
    (id:773, name:"Osyluth", ch:"U", color:9, speed:130, hp:"40d100", ac:75, alert:80, aaf:20, depth:65, rarity:2, weight:1, exp:13000, blows:[(method:"HIT", effect:"LOSE_CHR", dice:"8d8"), (method:"HIT", effect:"LOSE_CHR", dice:"8d8"), (method:"BITE", effect:"POISON", dice:"10d10"), (method:"STING", effect:"LOSE_STR", dice:"9d9")], spell_freq:6, spells:["BA_COLD", "BA_ELEC", "BO_ICEE", "SCARE", "S_DEMON"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(20, 40, 20, 20), flags:["BASH_DOOR", "DEMON", "DROP_3D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "INVISIBLE", "MOVE_BODY", "NONLIVING", "NO_CONF", "NO_CUT", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL"], hdice:"40", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"It is a demon made almost entirely out of bones.  It is humanoid, but with a large tail similar to that of a giant scorpion, and emits a foul smell of decay and rot.  They are despised even in the hells. "),
    (id:774, name:"Dreadlord", ch:"G", color:4, speed:120, hp:"30d100", ac:150, alert:10, aaf:20, depth:62, rarity:2, weight:1, exp:20000, blows:[(method:"HIT", effect:"EXP_40", dice:"6d6"), (method:"HIT", effect:"EXP_40", dice:"6d6"), (method:"HIT", effect:"LOSE_STR", dice:"4d6"), (method:"HIT", effect:"LOSE_STR", dice:"4d6")], spell_freq:3, spells:["BA_NETH", "BLIND", "BRAIN_SMASH", "CONF", "DARKNESS", "DRAIN_MANA", "HOLD", "SCARE", "S_UNDEAD", "TELE_TO", "TPORT"], open_door:false, bash_door:false, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(10, 10, 60, 10), flags:["CAN_FLY", "COLD_BLOOD", "DROP_2D2", "DROP_3D2", "DROP_4D2", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "IM_POIS", "INVISIBLE", "NO_CONF", "NO_CUT", "NO_SLEEP", "ONLY_ITEM", "PASS_WALL", "RES_TELE", "TAKE_ITEM", "UNDEAD"], hdice:"30", hside:"100", body_parts:(0, 0, 0, 0, 0, 0), desc:"It is a massive form of animated death, its colour deeper than black.  It drinks in light, and space around it is twisted and torn by the weight of its evil.  It is unlife and it knows nothing but the stealing of souls and the stench of death.  Flee its hunger! "),
    (id:775, name:"Greater kraken", ch:"~", color:13, speed:120, hp:"40d100", ac:175, alert:80, aaf:30, depth:60, rarity:2, weight:10000, exp:25000, blows:[(method:"CRUSH", effect:"HURT", dice:"15d15"), (method:"CRUSH", effect:"HURT", dice:"15d15"), (method:"CRUSH", effect:"HURT", dice:"15d15"), (method:"CRUSH", effect:"HURT", dice:"15d15")], spell_freq:3, spells:["BA_WATE", "BLIND", "BR_ACID", "BR_DARK", "BR_POIS", "CAUSE_3", "CAUSE_4", "CONF", "DARKNESS", "SCARE", "TELE_AWAY", "TELE_TO"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(10, 80, 0, 10), flags:["AQUATIC", "BASH_DOOR", "DROP_3D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_ELEC", "IM_FIRE", "IM_POIS", "MOVE_BODY", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "POWERFUL", "RES_WATE", "SMART", "WILD_OCEAN", "WILD_TOO"], hdice:"40", hside:"100", body_parts:(3, 0, 3, 0, 1, 0), desc:"An enormously fearsome and powerful inhabitant of the depths. It resembles a gargantuan octopus and its evil is almost tangible. "),
    (id:776, name:"Archlich", ch:"L", color:14, speed:120, hp:"45d100", ac:120, alert:50, aaf:20, depth:64, rarity:2, weight:1, exp:20000, blows:[(method:"TOUCH", effect:"EXP_80", dice:"0d0"), (method:"TOUCH", effect:"UN_POWER", dice:"0d0"), (method:"TOUCH", effect:"LOSE_DEX", dice:"8d12"), (method:"TOUCH", effect:"LOSE_DEX", dice:"8d12")], spell_freq:3, spells:["BA_NETH", "BLIND", "BLINK", "BRAIN_SMASH", "CAUSE_4", "DRAIN_MANA", "FORGET", "HEAL", "HOLD", "SCARE", "S_DEMON", "S_HI_UNDEAD", "TELE_TO", "TPORT"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 100, 0), flags:["BASH_DOOR", "CAN_FLY", "COLD_BLOOD", "DROP_2D2", "DROP_4D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "IM_POIS", "NO_CONF", "NO_CUT", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "PASS_WALL", "RES_TELE", "SMART", "UNDEAD"], hdice:"45", hside:"100", body_parts:(0, 0, 0, 0, 0, 0), desc:"A lich who has reached its ultimate evolutionary stage: a completely immaterial state. "),
