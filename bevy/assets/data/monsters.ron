    (id:778, name:"Jabberwock", ch:"H", color:10, speed:130, hp:"32d100", ac:125, alert:255, aaf:35, depth:68, rarity:3, weight:2300, exp:19000, blows:[(method:"CLAW", effect:"HURT", dice:"10d10"), (method:"CLAW", effect:"HURT", dice:"10d10"), (method:"BITE", effect:"HURT", dice:"10d10"), (method:"BITE", effect:"HURT", dice:"10d10")], spell_freq:5, spells:["BR_CHAO", "CAUSE_4"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(20, 50, 20, 0), flags:["ANIMAL", "ATTR_MULTI", "BASH_DOOR", "CAN_FLY", "DROP_60", "DROP_90", "DROP_CORPSE", "FORCE_MAXHP", "FORCE_SLEEP", "MORTAL", "ONLY_ITEM", "RES_TELE"], hdice:"32", hside:"100", body_parts:(0, 1, 0, 2, 1, 0), desc:"'Twas brillig, and the slithy toves / Did gyre and gimble in the wabe: /All mimsy were the borogoves, / And the mome raths outgrabe. /\"Beware the Jabberwock, my son! / The jaws that bite, the claws that catch!\" "),
    (id:779, name:"Chaos hound", ch:"Z", color:10, speed:120, hp:"60d30", ac:100, alert:0, aaf:30, depth:65, rarity:2, weight:900, exp:10000, blows:[(method:"BITE", effect:"HURT", dice:"2d12"), (method:"BITE", effect:"HURT", dice:"2d12"), (method:"BITE", effect:"HURT", dice:"2d12"), (method:"CLAW", effect:"HURT", dice:"2d12")], spell_freq:5, spells:["BR_CHAO"], open_door:false, bash_door:true, never_move:false, unique:false, friends:true, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "ATTR_ANY", "ATTR_MULTI", "BASH_DOOR", "DROP_CORPSE", "DROP_SKELETON", "FORCE_SLEEP", "FRIENDS", "NO_CONF", "NO_SLEEP"], hdice:"60", hside:"30", body_parts:(0, 1, 0, 2, 1, 0), desc:"A constantly changing canine form, this hound rushes towards you as if expecting mayhem and chaos ahead. It appears to have an almost kamikaze relish for combat. You suspect all may not be as it seems. "),
    (id:781, name:"Beholder hive-mother", ch:"e", color:11, speed:120, hp:"40d100", ac:80, alert:10, aaf:30, depth:67, rarity:3, weight:2600, exp:17000, blows:[(method:"BITE", effect:"EXP_80", dice:"6d6"), (method:"GAZE", effect:"PARALYZE", dice:"5d5"), (method:"GAZE", effect:"INSANITY", dice:"5d5"), (method:"GAZE", effect:"UN_POWER", dice:"5d5")], spell_freq:2, spells:["BA_ACID", "BA_COLD", "BA_DARK", "BA_FIRE", "BLIND", "BO_MANA", "BO_NETH", "BRAIN_SMASH", "CONF", "DRAIN_MANA", "FORGET", "SCARE", "S_KIN"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "DROP_CORPSE", "EVIL", "FEMALE", "FORCE_MAXHP", "FORCE_SLEEP", "IM_POIS", "NO_CONF", "NO_SLEEP", "RES_TELE", "SMART"], hdice:"40", hside:"100", body_parts:(0, 0, 0, 0, 0, 0), desc:"A hive mother of the race of beholders, she can summon her brood to her aid whenever she wishes. "),
