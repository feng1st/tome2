    (id:696, name:"Grand master thief", ch:"p", color:6, speed:130, hp:"15d100", ac:75, alert:40, aaf:50, depth:46, rarity:2, weight:1, exp:1500, blows:[(method:"HIT", effect:"EAT_ITEM", dice:"5d5"), (method:"HIT", effect:"EAT_ITEM", dice:"5d5"), (method:"HIT", effect:"EAT_GOLD", dice:"5d5"), (method:"HIT", effect:"EAT_GOLD", dice:"5d5")], spell_freq:2, spells:["ARROW_2", "BLINK", "CONF", "TELE_TO", "TPORT"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(70, 10, 10, 10), flags:["BASH_DOOR", "DROP_2D2", "EVIL", "MALE", "OPEN_DOOR", "TAKE_ITEM"], hdice:"15", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"A class of its own: you are already too late to protect your possessions - and he seems to have studied magic too, and is a master of setting traps. "),
    (id:697, name:"Smaug the Golden", ch:"D", color:12, speed:120, hp:"24d100", ac:150, alert:80, aaf:30, depth:48, rarity:2, weight:230000, exp:23000, blows:[(method:"CLAW", effect:"HURT", dice:"4d12"), (method:"CLAW", effect:"HURT", dice:"4d12"), (method:"BITE", effect:"FIRE", dice:"5d14"), (method:"BITE", effect:"FIRE", dice:"5d14")], spell_freq:4, spells:["BR_FIRE", "CAUSE_3", "CONF"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DRAGON", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "DROP_GREAT", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_FIRE", "MALE", "MOVE_BODY", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "REFLECTING", "SMART", "UNIQUE"], hdice:"24", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"Smaug is one of the Uruloki that still survive, a fire-drake of immense cunning and intelligence.  His speed through air is matched by few other dragons, his dragonfire is legendary, and his hide is armoured with diamonds. He is believed to be the greatest dragon still surviving into the Third Age. "),
    (id:699, name:"Knight Templar", ch:"p", color:1, speed:120, hp:"60d20", ac:60, alert:10, aaf:20, depth:44, rarity:2, weight:1800, exp:2000, blows:[(method:"HIT", effect:"HURT", dice:"5d5"), (method:"HIT", effect:"HURT", dice:"5d5"), (method:"HIT", effect:"HURT", dice:"5d5")], spell_freq:4, spells:["BLIND", "CAUSE_3", "CAUSE_4", "HASTE", "HEAL", "SCARE", "S_ANGEL"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 100, 0, 0), flags:["BASH_DOOR", "DROP_2D2", "DROP_90", "DROP_CORPSE", "DROP_SKELETON", "FORCE_MAXHP", "GOOD", "HAS_LITE", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "MALE", "MORTAL", "NO_CONF", "NO_FEAR", "NO_SLEEP", "NO_STUN", "OPEN_DOOR", "REFLECTING", "RES_DISE", "RES_NETH", "RES_NEXU", "RES_TELE"], hdice:"60", hside:"20", body_parts:(1, 1, 1, 2, 1, 1), desc:"It seems that the more devout the person, the more likely they are to cross the boundary between piety and sanctimoniousness.  And such is the case with the Order of the Knights Templar; they are among the most pious and powerful of the religious knightly orders, but noted for their intolerance.  Thus it is Morgoth's will that is unwittingly done, as the forces of good are set against each other. "),
    (id:701, name:"Dracolich", ch:"D", color:13, speed:120, hp:"35d100", ac:120, alert:80, aaf:25, depth:55, rarity:2, weight:180000, exp:18000, blows:[(method:"CLAW", effect:"HURT", dice:"4d12"), (method:"CLAW", effect:"HURT", dice:"4d12"), (method:"BITE", effect:"EXP_80", dice:"7d14")], spell_freq:6, spells:["BR_COLD", "BR_NETH", "CONF", "SCARE"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(10, 50, 40, 0), flags:["ATTR_MULTI", "BASH_DOOR", "CAN_FLY", "COLD_BLOOD", "DRAGON", "DROP_4D2", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_COLD", "IM_POIS", "MOVE_BODY", "NO_CONF", "NO_CUT", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "RES_TELE", "TAKE_ITEM", "UNDEAD"], hdice:"35", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"The skeletal form of a once-great dragon, enchanted by magic most perilous. Its animated form strikes with speed and drains life from its prey to satisfy its hunger. "),
    (id:702, name:"Greater titan", ch:"P", color:3, speed:120, hp:"38d100", ac:125, alert:15, aaf:30, depth:66, rarity:3, weight:50000, exp:23500, blows:[(method:"HIT", effect:"CONFUSE", dice:"12d12"), (method:"HIT", effect:"CONFUSE", dice:"12d12"), (method:"HIT", effect:"CONFUSE", dice:"12d12"), (method:"HIT", effect:"CONFUSE", dice:"12d12")], spell_freq:3, spells:["HEAL", "S_MONSTERS", "TELE_TO"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 100, 0, 0), flags:["BASH_DOOR", "DROP_1D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "DROP_SKELETON", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "GIANT", "HAS_LITE", "MALE", "MOVE_BODY", "ONLY_ITEM", "OPEN_DOOR", "SMART", "TAKE_ITEM"], hdice:"38", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"A forty foot tall humanoid that shakes the ground as it walks. The power radiating from its frame shakes your courage, its hatred inspired by your defiance. "),
    (id:703, name:"Dracolisk", ch:"D", color:12, speed:120, hp:"35d100", ac:120, alert:80, aaf:25, depth:55, rarity:2, weight:180000, exp:18000, blows:[(method:"CLAW", effect:"HURT", dice:"4d12"), (method:"CLAW", effect:"HURT", dice:"4d12"), (method:"BITE", effect:"FIRE", dice:"7d14"), (method:"GAZE", effect:"PARALYZE", dice:"0d0")], spell_freq:6, spells:["BR_FIRE", "BR_NEXU", "HOLD", "SCARE"], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 50, 40, 10), flags:["ANIMAL", "ATTR_MULTI", "BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "IM_ACID", "IM_FIRE", "NO_CONF", "NO_SLEEP", "ONLY_ITEM", "OPEN_DOOR", "RES_NEXU", "RES_TELE"], hdice:"35", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"A mixture of dragon and basilisk, the dracolisk stares at you with deep piercing eyes, its evil breath burning the ground where it stands. "),
    (id:704, name:"Winged Horror", ch:"B", color:8, speed:120, hp:"25d80", ac:80, alert:5, aaf:30, depth:48, rarity:3, weight:4500, exp:4000, blows:[(method:"CLAW", effect:"HURT", dice:"3d8"), (method:"CLAW", effect:"HURT", dice:"3d8"), (method:"BITE", effect:"EXP_40", dice:"4d6"), (method:"BITE", effect:"EXP_40", dice:"4d6")], spell_freq:6, spells:["BR_DARK", "BR_NETH", "BR_POIS"], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "BASH_DOOR", "CAN_FLY", "EVIL", "IM_COLD", "IM_POIS", "MORTAL", "WILD_TOO", "WILD_WASTE", "WILD_WOOD"], hdice:"25", hside:"80", body_parts:(0, 0, 0, 0, 0, 0), desc:"A terrifying sight:  a winged creature greater than any bird you have ever seen, and with no feathers on its horrid black leathery wings.  Descended from a creature of an older world perhaps, bred by Sauron to be a winged steed for his Ringwraiths. "),
    (id:708, name:"Ent", ch:"#", color:13, speed:110, hp:"40d100", ac:120, alert:15, aaf:30, depth:46, rarity:3, weight:1, exp:12500, blows:[(method:"CRUSH", effect:"HURT", dice:"12d13"), (method:"CRUSH", effect:"HURT", dice:"12d13"), (method:"CRUSH", effect:"HURT", dice:"12d13"), (method:"CRUSH", effect:"HURT", dice:"12d13")], spell_freq:0, spells:[], open_door:false, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(30, 50, 20, 0), flags:["BASH_DOOR", "DROP_4D2", "DROP_GOOD", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "KILL_WALL", "MOVE_BODY", "NO_CUT", "ONLY_ITEM", "PET", "SMART", "SUSCEP_FIRE", "TAKE_ITEM"], hdice:"40", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"A tree-herd: a sentient, moving tree. Its wrath is fearsome, and it could split stones and even the very rock of Isengard with its roots. "),
    (id:709, name:"Hru", ch:"P", color:2, speed:120, hp:"40d100", ac:150, alert:15, aaf:30, depth:54, rarity:3, weight:40000, exp:14500, blows:[(method:"HIT", effect:"SHATTER", dice:"12d13"), (method:"HIT", effect:"SHATTER", dice:"12d13"), (method:"HIT", effect:"SHATTER", dice:"12d13"), (method:"HIT", effect:"SHATTER", dice:"12d13")], spell_freq:0, spells:[], open_door:true, bash_door:true, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["BASH_DOOR", "DROP_4D2", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "GIANT", "HAS_LITE", "HURT_ROCK", "KILL_WALL", "MALE", "MOVE_BODY", "NO_CUT", "ONLY_GOLD", "OPEN_DOOR", "SMART", "TAKE_ITEM"], hdice:"40", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"A rock giant, a being made of living stone. "),
    (id:710, name:"Itangast the Fire Drake", ch:"D", color:12, speed:120, hp:"22d100", ac:120, alert:70, aaf:30, depth:47, rarity:2, weight:220000, exp:20000, blows:[(method:"CLAW", effect:"HURT", dice:"4d10"), (method:"CLAW", effect:"HURT", dice:"4d10"), (method:"BITE", effect:"FIRE", dice:"4d14"), (method:"BITE", effect:"FIRE", dice:"4d14")], spell_freq:4, spells:["BR_FIRE", "CAUSE_3", "CONF"], open_door:false, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(50, 50, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "DRAGON", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_FIRE", "MALE", "MOVE_BODY", "ONLY_ITEM", "POWERFUL", "SUSCEP_COLD", "UNIQUE"], hdice:"22", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"A mighty ancient dragon, Itangast's form scorches your flesh. Wisps of smoke curl up from his nostrils as he regards you with disdain. "),
    (id:711, name:"Death mold", ch:"m", color:8, speed:140, hp:"100d20", ac:60, alert:0, aaf:200, depth:47, rarity:1, weight:100, exp:1000, blows:[(method:"SPORE", effect:"UN_BONUS", dice:"7d7"), (method:"SPORE", effect:"UN_BONUS", dice:"7d7"), (method:"SPORE", effect:"UN_BONUS", dice:"7d7"), (method:"SPORE", effect:"EXP_80", dice:"5d5")], spell_freq:0, spells:[], open_door:false, bash_door:false, never_move:true, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["CAN_SWIM", "EVIL", "FORCE_SLEEP", "IM_ACID", "IM_COLD", "IM_ELEC", "IM_FIRE", "IM_POIS", "NEVER_MOVE", "NO_CONF", "NO_CUT", "NO_FEAR", "NO_SLEEP"], hdice:"100", hside:"20", body_parts:(0, 0, 0, 0, 0, 0), desc:"It is the epitome of all that is evil, in a mold. Its lifeless form draws power from sucking the souls of those that approach it; a nimbus of pure evil surrounds it. Luckily for you, it can't move... "),
    (id:714, name:"Quickbeam, the Ent", ch:"#", color:13, speed:120, hp:"40d100", ac:120, alert:15, aaf:30, depth:47, rarity:3, weight:1, exp:13500, blows:[(method:"CRUSH", effect:"HURT", dice:"12d13"), (method:"CRUSH", effect:"HURT", dice:"12d13"), (method:"CRUSH", effect:"HURT", dice:"12d13"), (method:"CRUSH", effect:"HURT", dice:"12d13")], spell_freq:0, spells:[], open_door:false, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(10, 50, 20, 10), flags:["BASH_DOOR", "CAN_SPEAK", "DROP_4D2", "DROP_GOOD", "FORCE_MAXHP", "FORCE_SLEEP", "GOOD", "KILL_WALL", "MOVE_BODY", "NO_CUT", "ONLY_ITEM", "PET", "SMART", "SUSCEP_FIRE", "TAKE_ITEM", "UNIQUE"], hdice:"40", hside:"100", body_parts:(1, 1, 1, 2, 1, 1), desc:"Unusually hasty, for an ent.  Quickbeam hates evil creatures, and orcs in particular, since the destruction of his beloved rowan-trees to feed the fires of Orthanc. "),
    (id:715, name:"Glaurung, Father of the Dragons", ch:"D", color:12, speed:130, hp:"120d100", ac:125, alert:70, aaf:20, depth:70, rarity:2, weight:300000, exp:50000, blows:[(method:"CLAW", effect:"HURT", dice:"5d12"), (method:"CLAW", effect:"HURT", dice:"5d12"), (method:"BITE", effect:"FIRE", dice:"8d14"), (method:"BITE", effect:"POISON", dice:"8d14")], spell_freq:3, spells:["BLIND", "BR_FIRE", "BR_POIS", "BR_SOUN", "CONF", "SCARE", "S_HI_DRAGON"], open_door:true, bash_door:true, never_move:false, unique:true, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(30, 70, 0, 0), flags:["BASH_DOOR", "CAN_FLY", "CAN_SPEAK", "DRAGON", "DROP_3D2", "DROP_4D2", "DROP_CORPSE", "DROP_GOOD", "DROP_GREAT", "DROP_RANDART", "EVIL", "FORCE_MAXHP", "FORCE_SLEEP", "HAS_LITE", "IM_FIRE", "IM_POIS", "MALE", "MOVE_BODY", "ONLY_ITEM", "OPEN_DOOR", "POWERFUL", "SMART", "SPECIAL_GENE", "UNIQUE"], hdice:"120", hside:"100", body_parts:(0, 1, 0, 6, 1, 0), desc:"Glaurung is the father of all dragons, and was for a long time the most powerful.  Though this is no longer so, he still has full command over his brood and can command them to appear whenever he so wishes.  He is the definition of dragonfire. "),
    (id:716, name:"Behemoth", ch:"H", color:14, speed:120, hp:"50d100", ac:180, alert:30, aaf:25, depth:49, rarity:3, weight:6000, exp:16000, blows:[(method:"BITE", effect:"FIRE", dice:"5d8"), (method:"BITE", effect:"FIRE", dice:"5d8"), (method:"CRUSH", effect:"HURT", dice:"3d15"), (method:"CRUSH", effect:"HURT", dice:"3d15")], spell_freq:9, spells:["BR_FIRE"], open_door:false, bash_door:false, never_move:false, unique:false, friends:false, escort:false, artifact_idx:0, artifact_chance:0, objs:(0, 0, 0, 0), flags:["ANIMAL", "AQUATIC", "CAN_SWIM", "DROP_CORPSE", "FORCE_MAXHP", "FORCE_SLEEP", "IM_ACID", "IM_COLD", "IM_FIRE", "IM_POIS", "MORTAL", "NO_CONF", "NO_FEAR", "NO_SLEEP"], hdice:"50", hside:"100", body_parts:(0, 1, 0, 2, 1, 0), desc:"A great water-beast, with an almost impenetrable skin. "),
