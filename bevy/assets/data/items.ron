    (id:136, name:"Ring of Speed", ch:"=", color:0, tval:45, sval:31, pval:0, fuel:0, spell:"", depth:75, rarity:1, weight:2, cost:100000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(75, 1)], flags:["HIDE_TYPE", "SPEED"], desc:["This wonderful ring grants you additional energy, allowing you to act faster."]),
    (id:138, name:"Ring of Teleportation", ch:"=", color:0, tval:45, sval:4, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:2, cost:250, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"DEST_TELE", btval:0, bsval:0, alloc:[(5, 1)], flags:["ACTIVATE", "CURSED", "EASY_KNOW", "TELEPORT"], desc:["This ring will uncontrollably send you to different places at its whim.", "You can use its power once at your will, but it will destroy the ring."]),
    (id:139, name:"Ring of Slow Digestion", ch:"=", color:0, tval:45, sval:6, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:2, cost:250, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["EASY_KNOW", "SLOW_DIGEST"], desc:["This magical bauble grants you some sustenance, allowing you to subsist on less food."]),
    (id:140, name:"Ring of Fire Resistance", ch:"=", color:0, tval:45, sval:8, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:2, cost:250, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["EASY_KNOW", "IGNORE_FIRE", "RES_FIRE"], desc:["This piece of jewellery grants you some protection from the burning heat of fire."]),
    (id:141, name:"Ring of Cold Resistance", ch:"=", color:0, tval:45, sval:9, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:2, cost:250, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["EASY_KNOW", "IGNORE_COLD", "RES_COLD"], desc:["This piece of jewellery grants you some protection from the chilling forces of cold."]),
    (id:142, name:"Ring of Levitation", ch:"=", color:0, tval:45, sval:7, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:2, cost:200, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["EASY_KNOW", "FEATHER"], desc:["When you put on this ring, you will be able to float just above the floor.", "It prevents you from drowning, and all your falls will be painless."]),
    (id:143, name:"Ring of Poison Resistance", ch:"=", color:0, tval:45, sval:20, pval:0, fuel:0, spell:"", depth:60, rarity:1, weight:2, cost:16000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(60, 2)], flags:["EASY_KNOW", "RES_POIS"], desc:["This magical ring grants protection from poison.", "It is rumoured that in deep dungeons monsters can kill you at once if you", "don't have poison resistance."]),
    (id:144, name:"Ring of Free Action", ch:"=", color:0, tval:45, sval:21, pval:0, fuel:0, spell:"", depth:20, rarity:1, weight:2, cost:1500, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:["EASY_KNOW", "FREE_ACT"], desc:["This magical bauble prevents you from being held.", "Some monsters will paralyse you and then kill you if you lack free action."]),
    (id:145, name:"Ring of Weakness", ch:"=", color:0, tval:45, sval:2, pval:-5, fuel:0, spell:"", depth:5, rarity:1, weight:2, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["CURSED", "HIDE_TYPE", "STR"], desc:["This accursed ring will sap your strength, rendering you much weaker as long as you wear it."]),
    (id:146, name:"Ring of Flames", ch:"=", color:0, tval:45, sval:18, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:2, cost:3000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:15, lite:0, activate:"BA_FIRE_4", btval:0, bsval:0, alloc:[(50, 1)], flags:["ACTIVATE", "IGNORE_FIRE", "RES_FIRE"], desc:["This fiery circlet grants you protection, makes fire less dangerous and even", "allows you to call forth a ball of flame."]),
