    (id:403, name:"Red Dragon Scale Mail", ch:"[", color:4, tval:38, sval:4, pval:0, fuel:0, spell:"", depth:60, rarity:1, weight:200, cost:50000, ac:30, dice:"2d4", to_h:-2, to_d:0, to_a:10, lite:0, activate:"BR_FIRE", btval:0, bsval:0, alloc:[(60, 8)], flags:["ACTIVATE", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_FIRE"], desc:["The skin of a dragon made into a suit of armour. It glows a bright red and radiates heat."]),
    (id:404, name:"Green Dragon Scale Mail", ch:"[", color:5, tval:38, sval:5, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:200, cost:40000, ac:30, dice:"2d4", to_h:-2, to_d:0, to_a:10, lite:0, activate:"BR_POIS", btval:0, bsval:0, alloc:[(50, 8)], flags:["ACTIVATE", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_POIS"], desc:["A suit of armour fashioned of dragon hide. It is dirty green and smells awful."]),
    (id:405, name:"Multi-Hued Dragon Scale Mail", ch:"[", color:10, tval:38, sval:6, pval:0, fuel:0, spell:"", depth:90, rarity:1, weight:200, cost:150000, ac:30, dice:"2d4", to_h:-2, to_d:0, to_a:10, lite:0, activate:"BR_MANY", btval:0, bsval:0, alloc:[(90, 32)], flags:["ACTIVATE", "ATTR_MULTI", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_ACID", "RES_COLD", "RES_ELEC", "RES_FIRE", "RES_POIS"], desc:["A powerful armour made of dragonhide. It glows red, blue, green, black and white."]),
    (id:406, name:"Pseudo Dragon Scale Mail", ch:"[", color:10, tval:38, sval:10, pval:0, fuel:0, spell:"", depth:70, rarity:1, weight:200, cost:70000, ac:30, dice:"2d4", to_h:-2, to_d:0, to_a:10, lite:0, activate:"BR_LIGHT", btval:0, bsval:0, alloc:[(70, 16)], flags:["ACTIVATE", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_DARK", "RES_LITE"], desc:["A suit of armour made of dragon hide, glowing with a strange light, or is it darkness?"]),
    (id:407, name:"Law Dragon Scale Mail", ch:"[", color:14, tval:38, sval:12, pval:0, fuel:0, spell:"", depth:80, rarity:1, weight:200, cost:80000, ac:30, dice:"2d4", to_h:-2, to_d:0, to_a:10, lite:0, activate:"BR_SHARD", btval:0, bsval:0, alloc:[(80, 16)], flags:["ACTIVATE", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_SHARDS", "RES_SOUND"], desc:["A piece of dragonhide cut and shaped so it can be worn as armour. The scales are very sharp,", "and the roaring of a storm seems to come from it, but you're not afraid of either."]),
    (id:408, name:"Bronze Dragon Scale Mail", ch:"[", color:15, tval:38, sval:14, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:200, cost:40000, ac:30, dice:"2d4", to_h:-2, to_d:0, to_a:10, lite:0, activate:"BR_CONF", btval:0, bsval:0, alloc:[(50, 8)], flags:["ACTIVATE", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_CONF"], desc:["A suit of armour made from dragon skin. Its brownish scales glitter in a dazzling light."]),
    (id:409, name:"Gold Dragon Scale Mail", ch:"[", color:11, tval:38, sval:16, pval:0, fuel:0, spell:"", depth:60, rarity:1, weight:200, cost:50000, ac:30, dice:"2d4", to_h:-2, to_d:0, to_a:10, lite:0, activate:"BR_SOUND", btval:0, bsval:0, alloc:[(60, 8)], flags:["ACTIVATE", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_SOUND"], desc:["A suit of golden-hued armour made of dragonhide. The rustle of its scales occasionally", "increases to a loud boom."]),
    (id:410, name:"Chaos Dragon Scale Mail", ch:"[", color:10, tval:38, sval:18, pval:0, fuel:0, spell:"", depth:80, rarity:1, weight:200, cost:80000, ac:30, dice:"2d4", to_h:-2, to_d:0, to_a:10, lite:0, activate:"BR_CHAOS", btval:0, bsval:0, alloc:[(80, 16)], flags:["ACTIVATE", "ATTR_MULTI", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_CHAOS", "RES_DISEN"], desc:["A suit of armour made of dragon hide. It glows in colours you have never seen before. As you", "put it on, you feel like you could change the world and are no longer afraid of your equipment", "losing its magic."]),
    (id:411, name:"Balance Dragon Scale Mail", ch:"[", color:10, tval:38, sval:20, pval:0, fuel:0, spell:"", depth:95, rarity:1, weight:200, cost:100000, ac:30, dice:"2d4", to_h:-2, to_d:0, to_a:10, lite:0, activate:"BR_BALANCE", btval:0, bsval:0, alloc:[(95, 32)], flags:["ACTIVATE", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_CHAOS", "RES_DISEN", "RES_SHARDS", "RES_SOUND"], desc:["A suit of armour made of the hide of a dead dragon. When wearing it, you feel like you", "understand the principles of law and chaos, and no longer fear either."]),
    (id:412, name:"Power Dragon Scale Mail", ch:"[", color:10, tval:38, sval:30, pval:0, fuel:0, spell:"", depth:100, rarity:1, weight:250, cost:350000, ac:40, dice:"2d4", to_h:-3, to_d:0, to_a:15, lite:0, activate:"BR_POWER", btval:0, bsval:0, alloc:[(100, 64)], flags:["ACTIVATE", "ATTR_MULTI", "FLY", "IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "RES_ACID", "RES_CHAOS", "RES_COLD", "RES_CONF", "RES_DARK", "RES_DISEN", "RES_ELEC", "RES_FIRE", "RES_LITE", "RES_NETHER", "RES_NEXUS", "RES_POIS", "RES_SHARDS", "RES_SOUND"], desc:["A suit of armour made of a very thick richly coloured dragonhide. You think you'll never have", "to fear dragons if you put it on."]),
    (id:413, name:"Dragon Helm", ch:"]", color:13, tval:32, sval:7, pval:0, fuel:0, spell:"", depth:45, rarity:1, weight:50, cost:10000, ac:8, dice:"1d3", to_h:0, to_d:0, to_a:10, lite:0, activate:"", btval:0, bsval:0, alloc:[(80, 4)], flags:["IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE"], desc:["An iron helmet, covered with a layer of dragonhide. It offers great protection and may grant", "protection against some dragon's attacks, based on the dragon the hide was taken from."]),
    (id:414, name:"Dragon Shield", ch:"[", color:13, tval:34, sval:6, pval:0, fuel:0, spell:"", depth:70, rarity:1, weight:100, cost:10000, ac:8, dice:"1d3", to_h:0, to_d:0, to_a:10, lite:0, activate:"", btval:0, bsval:0, alloc:[(80, 4)], flags:["IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE"], desc:["A large shield, with a dragonskin cover. Depending on which dragon the hide came from, it", "might grant protection against some sorts of dragon breath."]),
    (id:415, name:"Death", ch:"!", color:0, tval:71, sval:23, pval:0, fuel:0, spell:"", depth:55, rarity:1, weight:4, cost:0, ac:0, dice:"20d20", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(55, 4)], flags:["FOUNTAIN"], desc:["A potent and very quickly working poison, sometimes utilised by those who wish to end their", "lives. It is immensely toxic and will seriously hurt you even if you just get some of it on your", "hands."]),
    (id:416, name:"Ruination", ch:"!", color:0, tval:71, sval:15, pval:0, fuel:0, spell:"", depth:40, rarity:1, weight:4, cost:0, ac:0, dice:"20d20", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 8)], flags:["FOUNTAIN"], desc:["This wicked potion will seriously damage your abilities beyond the powers of magical", "restoration."]),
    (id:417, name:"Detonations", ch:"!", color:0, tval:71, sval:22, pval:0, fuel:0, spell:"", depth:60, rarity:1, weight:4, cost:10000, ac:0, dice:"25d25", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(60, 8)], flags:["FOUNTAIN"], desc:["This bottle is filled with a strange substance which will violently explode if strongly agitated.", "You don't want to know what it might do to your intestines."]),
    (id:418, name:"Augmentation", ch:"!", color:0, tval:71, sval:55, pval:0, fuel:0, spell:"", depth:40, rarity:1, weight:4, cost:60000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 16)], flags:["FOUNTAIN"], desc:["This blessed potion will greatly improve all your abilities, if they can still be improved."]),
    (id:419, name:"*Healing*", ch:"!", color:0, tval:71, sval:38, pval:0, fuel:0, spell:"", depth:40, rarity:1, weight:4, cost:1500, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 4), (60, 2), (80, 1)], flags:["FOUNTAIN"], desc:["This highly desirable potion will greatly help recovering from wounds, typically healing you", "fully."]),
    (id:420, name:"Life", ch:"!", color:0, tval:71, sval:39, pval:0, fuel:0, spell:"", depth:60, rarity:1, weight:4, cost:5000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(60, 4), (100, 2)], flags:[], desc:["This wonderful potion will fully heal you no matter how badly you're hurt, allow drained", "abilities to recover and remove various other ailments."]),
    (id:422, name:"*Enlightenment*", ch:"!", color:0, tval:71, sval:57, pval:0, fuel:0, spell:"", depth:70, rarity:1, weight:4, cost:80000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(70, 4)], flags:["FOUNTAIN"], desc:["This magical concoction will grant you great insight, magically improving your wits and", "wisdom, letting you know precisely who and where you are and what you possess."]),
    (id:425, name:"Ring of Fear Resistance", ch:"=", color:0, tval:45, sval:38, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:2, cost:300, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 2)], flags:["EASY_KNOW", "RES_FEAR"], desc:["This ring grants courage, so that you can never become afraid."]),
    (id:426, name:"Ring of Light and Darkness Resistance", ch:"=", color:0, tval:45, sval:39, pval:0, fuel:0, spell:"", depth:30, rarity:1, weight:2, cost:3000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(30, 2)], flags:["EASY_KNOW", "RES_DARK", "RES_LITE"], desc:["This ring protects against fluctuations of the light."]),
    (id:427, name:"Ring of Nether Resistance", ch:"=", color:0, tval:45, sval:40, pval:0, fuel:0, spell:"", depth:34, rarity:1, weight:2, cost:14500, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(34, 2)], flags:["EASY_KNOW", "HOLD_LIFE", "RES_NETHER"], desc:["This blessed ring improves your life force, protecting you from the draining forces of nether", "and other attempts to suck your lifeblood."]),
    (id:428, name:"Ring of Nexus Resistance", ch:"=", color:0, tval:45, sval:41, pval:0, fuel:0, spell:"", depth:24, rarity:1, weight:2, cost:3000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(24, 2)], flags:["EASY_KNOW", "RES_NEXUS"], desc:["This ring of stability protects you from the warping forces of nexus."]),
    (id:429, name:"Ring of Sound Resistance", ch:"=", color:0, tval:45, sval:42, pval:0, fuel:0, spell:"", depth:26, rarity:1, weight:2, cost:3000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(26, 2)], flags:["EASY_KNOW", "RES_SOUND"], desc:["This ring projects an aura of quiet around you, protecting you from loud noise."]),
    (id:430, name:"Ring of Confusion Resistance", ch:"=", color:0, tval:45, sval:43, pval:0, fuel:0, spell:"", depth:22, rarity:1, weight:2, cost:3000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(22, 2)], flags:["EASY_KNOW", "RES_CONF"], desc:["This ring stabilises your mind, protecting you from all kinds of befuddlement."]),
    (id:431, name:"Ring of Shard Resistance", ch:"=", color:0, tval:45, sval:44, pval:0, fuel:0, spell:"", depth:25, rarity:1, weight:2, cost:3000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(25, 2)], flags:["EASY_KNOW", "RES_SHARDS"], desc:["This piece of jewellery magically toughens your skin, protecting you from flying shrapnel."]),
    (id:432, name:"Ring of Disenchantment Resistance", ch:"=", color:0, tval:45, sval:45, pval:0, fuel:0, spell:"", depth:90, rarity:1, weight:2, cost:15000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(90, 10)], flags:["EASY_KNOW", "RES_DISEN"], desc:["This rare ring of preservation protects your equipment from attempts to sap its magic, also", "causing you to suffer less pain from such attacks."]),
    (id:433, name:"Ring of Chaos Resistance", ch:"=", color:0, tval:45, sval:46, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:2, cost:13000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 2)], flags:["EASY_KNOW", "RES_CHAOS", "RES_CONF"], desc:["This ring protects you from the horribly warping forces of chaos."]),
    (id:434, name:"Ring of Blindness Resistance", ch:"=", color:0, tval:45, sval:47, pval:0, fuel:0, spell:"", depth:60, rarity:1, weight:2, cost:7500, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(60, 2)], flags:["EASY_KNOW", "RES_BLIND"], desc:["This ring magically preserves your eyesight, making you impervious to any attempt to blind", "you."]),
    (id:435, name:"Ring of Lordly Protection", ch:"=", color:0, tval:45, sval:48, pval:0, fuel:0, spell:"", depth:100, rarity:1, weight:2, cost:100000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(100, 5)], flags:["FREE_ACT", "HOLD_LIFE", "RES_DISEN", "RES_POIS"], desc:["This blessed ring will protect you from disenchantment, poison, attempts to drain your life", "force and holding magic."]),
    (id:436, name:"Ring of Extra Attacks", ch:"=", color:0, tval:45, sval:49, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:2, cost:100000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 2)], flags:["BLOWS"], desc:["This powerful ring of fighters greatly enhances your fighting speed, allowing you to attack", "more often in a round of combat."]),
    (id:437, name:"Cure Light Wounds", ch:"!", color:0, tval:71, sval:34, pval:50, fuel:0, spell:"", depth:0, rarity:1, weight:4, cost:15, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(0, 1), (1, 1), (3, 1)], flags:["FOUNTAIN"], desc:["This healthy drink heals a little damage you have taken."]),
    (id:438, name:"Clumsiness", ch:"!", color:0, tval:71, sval:19, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:4, cost:0, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["FOUNTAIN"], desc:["This nasty concoction will numb your nerves, making you clumsier."]),
    (id:439, name:"Sickliness", ch:"!", color:0, tval:71, sval:20, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:4, cost:0, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["FOUNTAIN"], desc:["This unhealthy drink damages your health, reducing your physical constitution."]),
    (id:440, name:"Map of Bree", ch:"?", color:2, tval:8, sval:200, pval:0, fuel:0, spell:"", depth:3, rarity:100, weight:5, cost:100, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(3, 3)], flags:[], desc:["A map, showing the town of Bree and the landscape around it."]),
    (id:441, name:"Map of Gondolin", ch:"?", color:2, tval:8, sval:201, pval:0, fuel:0, spell:"", depth:70, rarity:100, weight:5, cost:50000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(70, 3)], flags:[], desc:["A map detailing the place of the hidden city of Gondolin. Consider yourself lucky someone", "lost a map here, since the location is yet unknown even to Morgoth."]),
    (id:442, name:"Map of Lothlorien", ch:"?", color:2, tval:8, sval:202, pval:0, fuel:0, spell:"", depth:6, rarity:100, weight:5, cost:1000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(6, 3)], flags:[], desc:["A map vaguely describing the forest of Lothlorien and the elven settlements therein."]),
    (id:443, name:"Map of Minas Anor", ch:"?", color:2, tval:8, sval:203, pval:0, fuel:0, spell:"", depth:36, rarity:100, weight:5, cost:10000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(36, 3)], flags:[], desc:["A map of the great city of Gondor."]),
    (id:465, name:"Silver Arrow", ch:"{", color:9, tval:17, sval:3, pval:0, fuel:0, spell:"", depth:55, rarity:1, weight:2, cost:35, ac:0, dice:"3d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4), (90, 2)], flags:["IGNORE_ACID", "IGNORE_FIRE", "SHOW_MODS", "SLAY_EVIL"], desc:["An arrow to be shot with a bow, its iron head coated with hallowed silver,", "a material that sears the flesh of all evil creatures."]),
    (id:466, name:"Silver Bolt", ch:"{", color:1, tval:18, sval:3, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:2, cost:40, ac:0, dice:"3d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(60, 4), (95, 2)], flags:["IGNORE_ACID", "IGNORE_FIRE", "SHOW_MODS", "SLAY_EVIL"], desc:["This crossbow bolt has a silver tip, blessed by the Valar for fighting evil."]),
    (id:467, name:"Amulet of Lightning Resistance", ch:"\"", color:0, tval:40, sval:29, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:3, cost:250, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["EASY_KNOW", "IGNORE_ELEC", "RES_ELEC"], desc:["This amulet will protect you from electrical discharges and storms."]),
    (id:468, name:"Amulet of Wisdom", ch:"\"", color:0, tval:40, sval:28, pval:0, fuel:0, spell:"", depth:30, rarity:1, weight:3, cost:500, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(30, 1)], flags:["HIDE_TYPE", "SUST_WIS", "WIS"], desc:["This magical amulet will magically make you wiser, and fend off", "attacks that would reduce your wisdom. Beware: if cursed, the", "amulet will do the opposite."]),
    (id:469, name:"Amulet of Regeneration", ch:"\"", color:0, tval:40, sval:30, pval:0, fuel:0, spell:"", depth:30, rarity:1, weight:3, cost:600, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(30, 3)], flags:["EASY_KNOW", "REGEN"], desc:["Wearing this amulet will trigger your body's regenerational", "processes quicker and make them proceed faster."]),
    (id:470, name:"Amulet of Infravision", ch:"\"", color:0, tval:40, sval:26, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:3, cost:200, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["HIDE_TYPE", "INFRA"], desc:["This amulet will increase your ability to sense warm-blooded", "creatures in your vicinity. Beware: if cursed, it will do", "just the opposite."]),
    (id:471, name:"Amulet of Devotion", ch:"\"", color:0, tval:40, sval:25, pval:0, fuel:0, spell:"", depth:70, rarity:1, weight:3, cost:30000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:1, activate:"", btval:0, bsval:0, alloc:[(70, 8)], flags:["CHR", "HIDE_TYPE", "HOLD_LIFE", "LITE1", "RES_DARK", "RES_FIRE", "RES_LITE", "SUST_CHR", "SUST_WIS", "WIS"], desc:["This blessed amulet will protect your wisdom and charms from", "diminishing, often adding to them as well. It also grants", "some extra protective magics by the grace of the Valar."]),
