    (id:219, name:"Holy Prayer", ch:"?", color:0, tval:70, sval:35, pval:0, fuel:0, spell:"", depth:25, rarity:1, weight:5, cost:80, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(25, 1)], flags:[], desc:["This incantation lets you fight as a warrior of Valinor for quite a while, supreme in attack and", "defence."]),
