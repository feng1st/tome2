    (id:206, name:"Recharging", ch:"?", color:0, tval:70, sval:22, pval:0, fuel:0, spell:"", depth:40, rarity:1, weight:5, cost:200, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 1)], flags:[], desc:["This scroll is inscribed with a spell releasing the enchantments used to give wands and", "staves their power, allowing you to replenish their spent charges."]),
    (id:207, name:"Genocide", ch:"?", color:0, tval:70, sval:44, pval:0, fuel:0, spell:"", depth:40, rarity:1, weight:5, cost:750, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 4), (80, 4)], flags:[], desc:["This rare and powerful scroll will annihilate all members of a specified race of monsters in", "your current location, but this will also exact a price of pain from you."]),
    (id:208, name:"Darkness", ch:"?", color:0, tval:70, sval:0, pval:0, fuel:0, spell:"", depth:1, rarity:1, weight:5, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(1, 1)], flags:[], desc:["This scroll will create a blast of utter darkness, which then fades to leave the immediate", "surroundings in a lasting gloom. The extreme darkness can blind those who are not used to", "it."]),
    (id:209, name:"Protection from Evil", ch:"?", color:0, tval:70, sval:37, pval:0, fuel:0, spell:"", depth:30, rarity:1, weight:5, cost:250, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(30, 1)], flags:[], desc:["Upon reading the runes on this piece of paper, a faint aura of holiness will spring into existence", "around you, protecting you from blows of evil creatures, unless they are more powerful than you."]),
    (id:210, name:"Satisfy Hunger", ch:"?", color:0, tval:70, sval:32, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:5, cost:10, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1), (20, 1), (50, 1), (75, 1)], flags:[], desc:["Reading this scroll will transport a good portion of nourishing gruel directly into your", "stomach. Some people say that this is a ploy of a food producer whose food nobody wants to eat."]),
    (id:211, name:"Dispel Undead", ch:"?", color:0, tval:70, sval:42, pval:0, fuel:0, spell:"", depth:40, rarity:1, weight:5, cost:200, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 1)], flags:[], desc:["A powerful exorcism is inscribed on this scroll. When read it will hurt undead abominations", "nearby, possibly even destroying them."]),
    (id:212, name:"*Enchant Weapon*", ch:"?", color:0, tval:70, sval:21, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:5, cost:500, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 1)], flags:[], desc:["Reading this scroll will magically infuse a weapon of your choice, making it more effective", "in combat."]),
    (id:213, name:"Curse Weapon", ch:"?", color:0, tval:70, sval:3, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:5, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 1)], flags:[], desc:["This scroll will ruin your weapon beyond repair. Only weapons of legend have a hope of", "escaping destruction, but even they will often be shattered."]),
    (id:214, name:"*Enchant Armour*", ch:"?", color:0, tval:70, sval:20, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:5, cost:500, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 1), (50, 1)], flags:[], desc:["This scroll will place a great enchantment on a piece of armour of your choice, making it much", "better at protecting you. Mark that improving armours which are already highly enchanted is very", "difficult and will often fail."]),
    (id:215, name:"Curse Armour", ch:"?", color:0, tval:70, sval:2, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:5, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 1)], flags:[], desc:["This scroll bears a curse that will tear your armour to shreds. Don't read it!"]),
