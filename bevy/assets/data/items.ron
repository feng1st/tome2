    (id:221, name:"*Destruction*", ch:"?", color:0, tval:70, sval:41, pval:0, fuel:0, spell:"", depth:40, rarity:1, weight:5, cost:250, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 1)], flags:[], desc:["This scroll is inscribed with a mighty conjuration which wrecks the dungeon all around you.", "Monsters and objects will be annihilated by this blast; only completely indestructible things can", "withstand it."]),
