    (id:330, name:"Tome of Magical Energy", ch:"?", color:14, tval:111, sval:0, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:30, cost:25000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4)], flags:["EASY_KNOW", "FULL_NAME"], desc:["The bright blue cover of this tome seems to glow", "with an inner violet light. You feel more attuned", "to raw magic as you hold it."]),
    (id:331, name:"Tome of the Eternal Flame", ch:"?", color:12, tval:111, sval:1, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:30, cost:25000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4)], flags:["EASY_KNOW", "FULL_NAME", "IGNORE_FIRE"], desc:["The cover of this tome is bright red, with flickering", "flames dancing across it once in a while. As you hold", "it, you begin to gain a much closer knowledge of all", "that is fiery."]),
    (id:332, name:"Tome of the Blowing Wind", ch:"?", color:6, tval:111, sval:2, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:30, cost:25000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4)], flags:["EASY_KNOW", "FULL_NAME", "IGNORE_ELEC"], desc:["The pages of this tome have a tendency to turn themselves,", "as though flipped by an errant wind. As you hold it,", "you start feeling wind at your fingertips."]),
    (id:333, name:"Tome of the Impenetrable Earth", ch:"?", color:15, tval:111, sval:3, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:30, cost:25000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4)], flags:["EASY_KNOW", "FULL_NAME", "IGNORE_ACID"], desc:["The solid leather cover of this tome seems permanently", "stained with caked mud and grass. Heavy it is to lift,", "yet strangely comforting to hold - you feel stronger", "and better supported."]),
    (id:334, name:"Tome of the Everrunning Wave", ch:"?", color:14, tval:111, sval:4, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:30, cost:25000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4)], flags:["EASY_KNOW", "FULL_NAME"], desc:["The cover and pages of this tome seem to be perpetually", "wet, though they are not wet to the touch. As you hold", "it, you begin to understand ocean storms better."]),
    (id:335, name:"Tome of Translocation", ch:"?", color:14, tval:111, sval:5, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:30, cost:25000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4)], flags:["EASY_KNOW", "FULL_NAME"], desc:["This book seems to flicker strangely. It's one of those books", "with an annoying tendency to disappear when you need it and", "reappear in the unlikeliest places. As you hold it, you start", "to understand what conveyance really means."]),
    (id:336, name:"Tome of the Tree", ch:"?", color:13, tval:111, sval:6, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:30, cost:25000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4)], flags:["EASY_KNOW", "FULL_NAME"], desc:["The cover of this tome is a bright shade of green, and it gives off", "a healthy, zesty scent that makes your thoughts clearer. As you", "hold it, your heart goes out to all living things upon Arda."]),
    (id:337, name:"Tome of Knowledge", ch:"?", color:8, tval:111, sval:7, pval:0, fuel:0, spell:"", depth:50, rarity:1, weight:30, cost:25000, ac:0, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4)], flags:["EASY_KNOW", "FULL_NAME"], desc:["A thick book with solid leather binding. It looks entirely", "unremarkable, but as you hold it, you feel strangely able", "to learn the inner workings of things and creatures."]),
