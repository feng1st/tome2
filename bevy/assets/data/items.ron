    (id:129, name:"Large Leather Shield", ch:")", color:15, tval:34, sval:4, pval:0, fuel:0, spell:"", depth:15, rarity:1, weight:100, cost:120, ac:4, dice:"1d2", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:[], desc:["A large oval or rectangular shield. It is made of wood, typically linden, and", "covered with a layer of hardened leather to offer better protection."]),
