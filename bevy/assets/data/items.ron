[
    (id:0, name:"something", ch:"&", color:1, tval:0, sval:0, pval:0, fuel:0, spell:"", depth:0, rarity:1, weight:0, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[], flags:[], desc:[]),
    (id:1, name:"Mushroom of Blindness", ch:",", color:0, tval:80, sval:1, pval:500, fuel:0, spell:"", depth:5, rarity:1, weight:1, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:[], desc:["'E'ating this mushrooms will blind you. You cannot cast magic", "or see monsters when you are blinded. You can still use magic items or", "quaff potions."]),
    (id:2, name:"Mushroom of Paranoia", ch:",", color:0, tval:80, sval:2, pval:500, fuel:0, spell:"", depth:5, rarity:1, weight:1, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:[], desc:["'E'ating this mushroom will make you scared.", "You will not be able to hit your enemies in combat if you're scared."]),
    (id:3, name:"Mushroom of Confusion", ch:",", color:0, tval:80, sval:3, pval:500, fuel:0, spell:"", depth:5, rarity:1, weight:1, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:[], desc:["'E'ating this mushroom will confuse you. You will not be able to cast spells,", "use wands, staves or scrolls. You can still quaff potions, though."]),
    (id:4, name:"Mushroom of Hallucination", ch:",", color:0, tval:80, sval:4, pval:500, fuel:0, spell:"", depth:10, rarity:1, weight:1, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:[], desc:["'E'ating this mushroom will make you hallucinate.", "You will not be able to recognise any monster or item."]),
    (id:5, name:"Mushroom of Cure Poison", ch:",", color:0, tval:80, sval:12, pval:500, fuel:0, spell:"", depth:10, rarity:1, weight:1, cost:60, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:[], desc:["'E'ating this mushroom will cure you from poison."]),
    (id:6, name:"Mushroom of Cure Blindness", ch:",", color:0, tval:80, sval:13, pval:500, fuel:0, spell:"", depth:10, rarity:1, weight:1, cost:50, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:[], desc:["'E'ating this mushroom will cure you from blindness."]),
    (id:7, name:"Mushroom of Cure Paranoia", ch:",", color:0, tval:80, sval:14, pval:500, fuel:0, spell:"", depth:10, rarity:1, weight:1, cost:25, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:[], desc:["'E'ating this mushroom will cure your paranoia.  Paranoia is the state when you are", "too afraid to attack monsters."]),
    (id:8, name:"Mushroom of Cure Confusion", ch:",", color:0, tval:80, sval:15, pval:500, fuel:0, spell:"", depth:10, rarity:1, weight:1, cost:50, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:[], desc:["'E'ating this mushroom will cure your confusion.  Confusion is when you are too confused", "to cast spells, zap staves, aim wands or read scrolls."]),
    (id:9, name:"Mushroom of Weakness", ch:",", color:0, tval:80, sval:6, pval:500, fuel:0, spell:"", depth:10, rarity:1, weight:1, cost:0, ac:0, dice:"5d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:[], desc:["'E'ating this mushroom will reduce your strength by one point."]),
    (id:10, name:"Mushroom of Unhealth", ch:",", color:0, tval:80, sval:10, pval:500, fuel:0, spell:"", depth:15, rarity:1, weight:1, cost:50, ac:0, dice:"10d10", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:[], desc:["'E'ating this mushroom will reduce your constitution by one point."]),
    (id:11, name:"Mushroom of Restore Constitution", ch:",", color:0, tval:80, sval:18, pval:500, fuel:0, spell:"", depth:20, rarity:1, weight:1, cost:350, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:[], desc:["'E'ating this mushroom will restore your constitution. Your constitution", "needs restoring when it is displayed in yellow."]),
    (id:12, name:"Mushroom of Restoring", ch:",", color:0, tval:80, sval:19, pval:500, fuel:0, spell:"", depth:20, rarity:1, weight:1, cost:1000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 8), (30, 4), (40, 1)], flags:[], desc:["'E'ating this mushroom will restore your strength, dexterity, constitution,", "intelligence, wisdom and charisma. These need restoring when they", "are displayed in yellow."]),
    (id:13, name:"Mushroom of Stupidity", ch:",", color:0, tval:80, sval:8, pval:500, fuel:0, spell:"", depth:15, rarity:1, weight:1, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:[], desc:["'E'ating this mushroom will reduce your intelligence by one point.", "That's a bad thing."]),
    (id:14, name:"Mushroom of Naivety", ch:",", color:0, tval:80, sval:9, pval:500, fuel:0, spell:"", depth:15, rarity:1, weight:1, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:[], desc:["'E'ating this mushroom will reduce your wisdom by one point.", "That's a bad thing."]),
    (id:15, name:"Mushroom of Poison", ch:",", color:0, tval:80, sval:0, pval:500, fuel:0, spell:"", depth:5, rarity:1, weight:1, cost:0, ac:0, dice:"4d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1), (5, 1)], flags:[], desc:["'E'ating this mushroom will poison you. Poisoning makes you lose one hitpoint", "per turn until you magically stop the poison or until your body has", "fought off the poison.", "That's a bad thing."]),
    (id:16, name:"Mushroom of Sickness", ch:",", color:0, tval:80, sval:7, pval:500, fuel:0, spell:"", depth:10, rarity:1, weight:1, cost:0, ac:0, dice:"4d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:[], desc:["'E'ating this mushroom will reduce your constitution by one point.", "It will also damage you quite severely in the process.", "That's a bad thing."]),
    (id:17, name:"Mushroom of Paralysis", ch:",", color:0, tval:80, sval:5, pval:500, fuel:0, spell:"", depth:20, rarity:1, weight:1, cost:0, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:[], desc:["'E'ating this mushroom will paralyse you for a certain time.", "Any nearby monsters will take this opportunity to kill you.", "That's a bad thing."]),
    (id:18, name:"Mushroom of Restore Strength", ch:",", color:0, tval:80, sval:17, pval:500, fuel:0, spell:"", depth:20, rarity:1, weight:1, cost:350, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:[], desc:["'E'ating this mushroom will restore your strength. Your strength", "needs restoring when it is displayed in yellow."]),
    (id:19, name:"Mushroom of Disease", ch:",", color:0, tval:80, sval:11, pval:500, fuel:0, spell:"", depth:20, rarity:1, weight:1, cost:50, ac:0, dice:"10d10", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:[], desc:["'E'ating this mushroom will reduce your strength by one point.", "It will also damage you quite severely in the process.", "That's a bad thing."]),
    (id:20, name:"Mushroom of Cure Serious Wounds", ch:",", color:0, tval:80, sval:16, pval:500, fuel:0, spell:"", depth:15, rarity:1, weight:1, cost:75, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:[], desc:["'E'ating this mushroom will heal several hit points. Your hit points", "need healing when they are displayed in yellow or red."]),
    (id:21, name:"Ration of Food", ch:",", color:15, tval:80, sval:35, pval:5000, fuel:0, spell:"", depth:0, rarity:1, weight:10, cost:3, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(0, 1), (5, 1), (10, 1)], flags:[], desc:["Lightweight and filling. Not an incredible taste experience, but that'd be asking a bit much.", "You can 'E'at it."]),
    (id:22, name:"Hard Biscuit", ch:",", color:15, tval:80, sval:32, pval:500, fuel:0, spell:"", depth:0, rarity:1, weight:2, cost:1, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[], flags:[], desc:["It doesn't look great, and 'E'ating it will only fill your stomach a bit,", "for a short time."]),
    (id:23, name:"Strip of Venison", ch:",", color:7, tval:80, sval:33, pval:1500, fuel:0, spell:"", depth:0, rarity:1, weight:2, cost:2, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[], flags:[], desc:["It looks great, and 'E'ating it will fill your stomach well."]),
    (id:24, name:"Slime Mold", ch:",", color:5, tval:80, sval:36, pval:3000, fuel:0, spell:"", depth:1, rarity:1, weight:5, cost:2, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(1, 1)], flags:[], desc:["It looks disgusting, but if you really want to you can 'E'at it.", "Not an incredible taste experience, but that'd be asking a bit much."]),
    (id:25, name:"Lembas", ch:",", color:14, tval:80, sval:37, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:3, cost:10, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1), (10, 1), (20, 1)], flags:[], desc:["A sort of cake, tasty and sustaining. It even helps to overcome weariness. Its fabrication", "is a secret of the elves. If you 'E'at it, you will be full."]),
    (id:26, name:"Pint of Fine Ale", ch:",", color:11, tval:80, sval:38, pval:500, fuel:0, spell:"", depth:0, rarity:1, weight:5, cost:1, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[], flags:[], desc:["A bottle of a dark beer-like beverage. You can drink it by pressing 'E'."]),
    (id:27, name:"Pint of Fine Wine", ch:",", color:4, tval:80, sval:39, pval:1000, fuel:0, spell:"", depth:0, rarity:1, weight:10, cost:2, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[], flags:[], desc:["A bottle of fine wine. You can drink it by pressing 'E'."]),
    (id:28, name:"Mattock", ch:"\\", color:8, tval:20, sval:7, pval:3, fuel:0, spell:"", depth:50, rarity:1, weight:250, cost:700, ac:0, dice:"1d8", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 2)], flags:["TUNNEL"], desc:["This is a digging tool. Use it to dig in walls, destroy doors, or cut wood."]),
    (id:29, name:"Blue Stone Amulet", ch:"\"", color:14, tval:40, sval:18, pval:0, fuel:0, spell:"", depth:60, rarity:1, weight:3, cost:90000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[], flags:["INSTA_ART", "SPECIAL_GENE"], desc:[]),
    (id:30, name:"Broken Dagger", ch:"|", color:8, tval:23, sval:1, pval:0, fuel:0, spell:"", depth:0, rarity:1, weight:5, cost:1, ac:0, dice:"1d1", to_h:-2, to_d:-4, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(0, 2), (5, 2)], flags:["SHOW_MODS"], desc:["The blade itself is a foot long and broken off not far above the hilt."]),
    (id:31, name:"Bastard Sword", ch:"|", color:9, tval:23, sval:21, pval:0, fuel:0, spell:"", depth:15, rarity:1, weight:140, cost:350, ac:0, dice:"3d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["This is a long, double-edged sword with a plain hilt that could", "be wielded in one or two hands. It's called a \"bastard sword\" because in", "size, it falls between the broad sword and the two-handed sword, thus not", "having a family of its own. It's typically around 51 inches long.", "It is effective for cutting through tougher armours. It could be used for", "thrusting, but most wielders swing it like a bat."]),
    (id:32, name:"Scimitar", ch:"|", color:9, tval:23, sval:18, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:130, cost:250, ac:0, dice:"2d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["SHOW_MODS"], desc:["This oriental blade has 2 edges and is deeply curved. It has a wide", "and very sharp end. It is the forefather of the sabre."]),
    (id:33, name:"Tulwar", ch:"|", color:9, tval:23, sval:15, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:100, cost:200, ac:0, dice:"2d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["SHOW_MODS"], desc:["This vicious sword is half sword and half club, with a slight hook on the tip."]),
    (id:34, name:"Broad Sword", ch:"|", color:9, tval:23, sval:16, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:150, cost:255, ac:0, dice:"2d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1), (15, 1)], flags:["SHOW_MODS"], desc:["This broader version of the long sword is a standard weapon in the army", "of Gondolin."]),
    (id:35, name:"Short Sword", ch:"|", color:9, tval:23, sval:10, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:80, cost:90, ac:0, dice:"1d7", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["SHOW_MODS"], desc:["This shorter version of the long sword is a common weapon for rogues", "and mages."]),
    (id:36, name:"Blade of Chaos", ch:"|", color:10, tval:23, sval:30, pval:0, fuel:0, spell:"", depth:70, rarity:1, weight:180, cost:4000, ac:0, dice:"6d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(70, 8)], flags:["ATTR_MULTI", "CHAOTIC", "RES_CHAOS", "SHOW_MODS"], desc:["A mighty sword which seems to be completely blunt. However, it is a conduit", "into the realms of pure chaos and strikes its victims with the devastating", "might of chaos itself whenever it connects. It gives you resistance to chaos", "and it can polymorph, teleport, confuse or drain hit points from the monster", "you hit. It occasionally causes earthquakes as well."]),
    (id:37, name:"Two-Handed Sword", ch:"|", color:9, tval:23, sval:25, pval:0, fuel:0, spell:"", depth:30, rarity:1, weight:200, cost:775, ac:0, dice:"3d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(30, 1), (40, 1)], flags:["MUST2H", "SHOW_MODS"], desc:["This blade is lot longer, wider and heavier than a long sword. You have to", "wield it with two hands. This means that wielding a shield makes fighting", "very difficult."]),
    (id:38, name:"Main Gauche", ch:"|", color:9, tval:23, sval:5, pval:0, fuel:0, spell:"", depth:3, rarity:1, weight:30, cost:25, ac:0, dice:"1d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(3, 1)], flags:["SHOW_MODS"], desc:["This blade is sinuously curved and tipped with a harpoon-like end.", "This blade has a large handguard and was designed as an off-hand weapon.", "This short but cruel blade is a favourite among orcs."]),
    (id:39, name:"Cutlass", ch:"|", color:9, tval:23, sval:12, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:110, cost:85, ac:0, dice:"1d7", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["SHOW_MODS"], desc:["This oriental weapon is a short, thick, curving sword", "with a single cutting edge. This simple slashing weapon", "is typically carried by buccaneers, pirates, and sailors."]),
    (id:40, name:"Executioner's Sword", ch:"|", color:4, tval:23, sval:28, pval:0, fuel:0, spell:"", depth:40, rarity:1, weight:260, cost:850, ac:0, dice:"4d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 1)], flags:["MUST2H", "SHOW_MODS"], desc:["These weapons have been built in all sizes. They are custom-made", "for warriors that want to set out and kill their archenemy. These", "blades are rare, costly and very deadly."]),
    (id:41, name:"Katana", ch:"|", color:9, tval:23, sval:20, pval:0, fuel:0, spell:"", depth:20, rarity:1, weight:120, cost:400, ac:0, dice:"3d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["The katana is a long blade with only a small disk for a guard.", "Its hilt is long enough for two hands, though it could be used", "with only one hand, and is usually wrapped in cloth or leather.", "The art of forging such swords is largely unknown in this part", "of Middle-earth, and such weapons are typically imported from", "distant lands."]),
    (id:42, name:"Long Sword", ch:"|", color:9, tval:23, sval:17, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:130, cost:300, ac:0, dice:"2d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1), (20, 1)], flags:["SHOW_MODS"], desc:["A long straight sword, tapering to a pronounced point. Mainly good for", "piercing attacks, but it can be used for slashing, too. It is a very", "popular design and has become standard issue in many armies."]),
    (id:43, name:"Dagger", ch:"|", color:9, tval:23, sval:4, pval:0, fuel:0, spell:"", depth:0, rarity:1, weight:12, cost:10, ac:0, dice:"1d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(0, 1), (5, 1), (10, 1), (20, 1)], flags:["SHOW_MODS"], desc:["It's the standard weapon of rogues and thieves.  The blade is", "a foot long."]),
    (id:44, name:"Rapier", ch:"|", color:9, tval:23, sval:7, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:40, cost:42, ac:0, dice:"1d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["SHOW_MODS"], desc:["The rapier's hilt consisted of a pair of oval guards pierced with holes,", "recurved quillions, and a knuckle guard.  The guard is very intricate", "and very effective as protection."]),
    (id:45, name:"Sabre", ch:"|", color:9, tval:23, sval:11, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:50, cost:50, ac:0, dice:"1d7", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["SHOW_MODS"], desc:["A long, one-edged, slightly curved sword with a knuckle guard and short", "hilt.  It is two-edged in its lower part."]),
    (id:46, name:"Small Sword", ch:"|", color:9, tval:23, sval:8, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:75, cost:48, ac:0, dice:"1d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["SHOW_MODS"], desc:["It's the favourite weapon of strong mages and thieves. The blade is", "about twenty inches long. It's very easy to handle, although it is a lot less", "efficient than the longer and heavier designs."]),
    (id:47, name:"Broken Sword", ch:"|", color:8, tval:23, sval:2, pval:0, fuel:0, spell:"", depth:0, rarity:1, weight:30, cost:2, ac:0, dice:"1d2", to_h:-2, to_d:-4, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(0, 2), (5, 2)], flags:["SHOW_MODS"], desc:["Just a hilt and a few inches of blade, broken off in a jagged stump.", "Probably worthless."]),
    (id:48, name:"Ball-and-Chain", ch:"\\", color:8, tval:21, sval:6, pval:0, fuel:0, spell:"", depth:20, rarity:1, weight:150, cost:200, ac:0, dice:"2d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["This weapon has a ball linked with a chain to a wooden handle.", "Preferred tactic is smashing the brains of your opponent."]),
    (id:49, name:"Whip", ch:"\\", color:8, tval:21, sval:2, pval:0, fuel:0, spell:"", depth:3, rarity:1, weight:30, cost:30, ac:0, dice:"1d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(3, 1)], flags:["SHOW_MODS"], desc:["Think Doctor Jones. This weapon is light and easy to fight with.", "It has nasty barbs and hooks fixed to the thong to make it useful", "in combat. Whips give easily multiple attacks."]),
    (id:50, name:"Flail", ch:"\\", color:8, tval:21, sval:13, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:150, cost:353, ac:0, dice:"2d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["This weapon was originally used to cut corn. More warlike versions", "sport a large blade stuck on a wooden handle. The hinge allows it to get", "past enemy defences or to strike with added momentum when used skillfully."]),
    (id:51, name:"Two-Handed Flail", ch:"\\", color:11, tval:21, sval:18, pval:0, fuel:0, spell:"", depth:45, rarity:1, weight:280, cost:590, ac:0, dice:"3d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(45, 1)], flags:["MUST2H", "SHOW_MODS"], desc:["This two-handed version of the flail gives the fighter a fearsome", "weapon that can do a fair amount of damage.  It typically has several", "spiked metal lumps on chains."]),
    (id:52, name:"Morning Star", ch:"\\", color:8, tval:21, sval:12, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:150, cost:396, ac:0, dice:"2d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["SHOW_MODS"], desc:["This weapon consists of a large club with chains that have wooden balls", "with metal spikes on the end."]),
    (id:53, name:"Mace", ch:"\\", color:8, tval:21, sval:5, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:120, cost:130, ac:0, dice:"2d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["This weapon is a club ending in a sphere. The sphere is studded", "with metal shards, and thus can both crush and cut your adversary."]),
    (id:54, name:"Quarterstaff", ch:"\\", color:15, tval:21, sval:3, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:150, cost:200, ac:0, dice:"1d9", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["A long, wooden pole, usually the height of the wielder. Four of them can be", "made out of the trunk of one young tree, hence the name. The quarterstaff", "is an excellent weapon for travellers as it doubles both as a walking staff", "and as a deterrent against brigands. The quarterstaff is used more in", "fencing and brawling than melee combat."]),
    (id:55, name:"War Hammer", ch:"\\", color:8, tval:21, sval:8, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:120, cost:225, ac:0, dice:"3d3", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["A large hammer, designed to crush skulls with mighty strikes."]),
    (id:56, name:"Lead-Filled Mace", ch:"\\", color:8, tval:21, sval:15, pval:0, fuel:0, spell:"", depth:15, rarity:1, weight:180, cost:502, ac:0, dice:"3d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["A large, mean mace filled with lead in order to wreak a maximum of havoc."]),
    (id:57, name:"Mace of Disruption", ch:"\\", color:10, tval:21, sval:20, pval:0, fuel:0, spell:"", depth:80, rarity:1, weight:400, cost:4300, ac:0, dice:"5d8", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(80, 5)], flags:["MUST2H", "SHOW_MODS", "SLAY_UNDEAD"], desc:["This mace is custom-made for priests that go out to destroy evil.", "It is deadly, especially for undead."]),
    (id:58, name:"Lucerne Hammer", ch:"\\", color:14, tval:21, sval:10, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:120, cost:376, ac:0, dice:"2d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["A war hammer combined with a spearpoint, mounted on a long pole."]),
    (id:59, name:"Beaked Axe", ch:"/", color:2, tval:22, sval:10, pval:0, fuel:0, spell:"", depth:15, rarity:1, weight:180, cost:408, ac:0, dice:"2d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:["MUST2H", "SHOW_MODS"], desc:["This polearm has a beak mounted opposite the blade."]),
    (id:60, name:"Glaive", ch:"/", color:2, tval:22, sval:13, pval:0, fuel:0, spell:"", depth:20, rarity:1, weight:190, cost:363, ac:0, dice:"2d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["A polearm with a long, slightly curved knife-like blade. It has spurs on", "the dull side of the blade. It's primarily a slashing and chopping weapon. Glaives", "are often used to protect archers, crossbowmen, and gunners while they reload.", "Outside of combat they are a popular processional weapon and therefore many", "have ornately carved blades."]),
    (id:61, name:"Halberd", ch:"/", color:2, tval:22, sval:15, pval:0, fuel:0, spell:"", depth:25, rarity:1, weight:190, cost:430, ac:0, dice:"3d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(25, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["The halberd has a broad, short axe blade on a 5 - 6ft long haft, with a", "spearpoint at the top, often a back-spike and occasionally a butt-spike. Used to", "combat heavier armour. It's usually used for cutting and stabbing.  It's the most", "versatile polearm in Middle-earth. The axe is used in general melee. The top", "pike is used to pierce armour, or is set against a cavalry charge. The back", "hook could unseat horses, trip opponents, parry a blow, or be a general", "piercing weapon."]),
    (id:62, name:"Awl-Pike", ch:"/", color:2, tval:22, sval:4, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:160, cost:340, ac:0, dice:"1d8", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["This is a polearm with a long square-sectioned spike on the end."]),
    (id:63, name:"Pike", ch:"/", color:2, tval:22, sval:8, pval:0, fuel:0, spell:"", depth:15, rarity:1, weight:160, cost:358, ac:0, dice:"2d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["A staff, 16-18 feet long, that has a small piercing head about 10 inches", "long. The pike is often used by infantry to fend off cavalry.  It is very", "effective against mounted troops."]),
    (id:64, name:"Spear", ch:"/", color:2, tval:22, sval:2, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:50, cost:36, ac:0, dice:"1d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["SHOW_MODS"], desc:["Spears tend to have a strong, wide, leaf-shaped head with a ridge down the", "middle. The spearhead is attached to the wooden shaft by a socket. The", "sockets are usually riveted to the shaft and some have two small lugs near", "the base of the socket to allow the head to be possibly bound on as well.", "This spear is 7 feet long."]),
    (id:65, name:"Trident", ch:"/", color:11, tval:22, sval:5, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:70, cost:120, ac:0, dice:"1d8", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["The trident is based on the pitchfork.  In fact, when not used as a weapon,", "it is often employed as a pitchfork. It is famous for its uses in", "gladiatorial arenas. It is used much like a spear and could even be thrown", "like one in desperate situations."]),
    (id:66, name:"Lance", ch:"/", color:2, tval:22, sval:20, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:300, cost:230, ac:0, dice:"2d8", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:["MUST2H", "SHOW_MODS"], desc:["This is the original polearm. It is shaped like a spear but is bigger. It's", "meant to fend off enemies, not to be thrown."]),
    (id:67, name:"Great Axe", ch:"/", color:2, tval:24, sval:25, pval:0, fuel:0, spell:"", depth:40, rarity:1, weight:230, cost:500, ac:0, dice:"4d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 1)], flags:["MUST2H", "SHOW_MODS"], desc:["A huge and heavy two-headed axe."]),
    (id:68, name:"Battle Axe", ch:"/", color:2, tval:22, sval:22, pval:0, fuel:0, spell:"", depth:15, rarity:1, weight:170, cost:334, ac:0, dice:"2d8", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["Nordic polearm with a broad blade and a hook mounted on the end of the shaft.", "The Nordics' take on the halberd. The polearm of choice for many Nordics,", "ideally suited for slashing, thrusting, and unseating cavalry."]),
    (id:69, name:"Lochaber Axe", ch:"/", color:8, tval:22, sval:28, pval:0, fuel:0, spell:"", depth:45, rarity:1, weight:250, cost:750, ac:0, dice:"3d8", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(45, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["Nordic polearm with a broad blade and a hook mounted on the end of the shaft.", "A Nordic version of the halberd. The polearm of choice for many Nordics,", "this weapon is ideally suited for slashing, thrusting, and unseating cavalry."]),
    (id:70, name:"Broad Axe", ch:"/", color:2, tval:24, sval:11, pval:0, fuel:0, spell:"", depth:15, rarity:1, weight:160, cost:304, ac:0, dice:"2d6", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["A one-headed axe made for combat, with an elongated moon-shaped blade."]),
    (id:71, name:"Scythe", ch:"/", color:2, tval:22, sval:17, pval:0, fuel:0, spell:"", depth:45, rarity:1, weight:250, cost:800, ac:0, dice:"5d3", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(45, 1)], flags:["COULD2H", "SHOW_MODS"], desc:["A simple farm implement, converted into a weapon by slightly straightening", "its blade and putting it in line with its pole, instead of the typical", "right angle."]),
    (id:72, name:"Scythe of Slicing", ch:"/", color:4, tval:22, sval:30, pval:0, fuel:0, spell:"", depth:80, rarity:1, weight:250, cost:10000, ac:0, dice:"8d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(80, 20)], flags:["MUST2H", "SHOW_MODS", "VORPAL", "WOUNDING"], desc:["The simple design of the war scythe, but this one uses a finely crafted and", "incredibly sharp steel blade which causes terrible wounds when it hits."]),
    (id:73, name:"Short Bow", ch:"}", color:15, tval:19, sval:12, pval:0, fuel:0, spell:"", depth:3, rarity:1, weight:30, cost:50, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(3, 1), (50, 2)], flags:["SHOW_MODS"], desc:["A piece of bent wood, fitted with a string. Easy to transport and use, but", "its effect is not very impressive. You can 'f'ire it after you 'w'ield it."]),
    (id:74, name:"Long Bow", ch:"}", color:15, tval:19, sval:13, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:40, cost:120, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1), (70, 2)], flags:["SHOW_MODS"], desc:["A bow almost as long as a human. It takes considerable strength and skill to", "use and is rather awkward to carry around inside buildings. Nevertheless, it", "shoots arrows with astonishing force. You can 'f'ire it after you 'w'ield it."]),
    (id:75, name:"Light Crossbow", ch:"}", color:2, tval:19, sval:23, pval:0, fuel:0, spell:"", depth:15, rarity:1, weight:110, cost:140, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(15, 1), (60, 2)], flags:["SHOW_MODS"], desc:["A metal bow mounted on a wooden stock. It is used for shooting bolts. This", "design is relatively light and not too difficult to cock, but also shoots its", "quarrels with less force. You can 'f'ire with it after you 'w'ield it."]),
    (id:76, name:"Heavy Crossbow", ch:"}", color:2, tval:19, sval:24, pval:0, fuel:0, spell:"", depth:30, rarity:1, weight:200, cost:300, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(30, 1), (80, 2)], flags:["SHOW_MODS"], desc:["A metal bow mounted on a wooden stock, with attached cocking mechanism. It", "takes considerable time and strength to cock it and it's rather heavy.", "However, it hurls its ammunition with incredible force. You can 'f'ire with", "it after you 'w'ield it."]),
    (id:77, name:"Sling", ch:"}", color:7, tval:19, sval:2, pval:0, fuel:0, spell:"", depth:1, rarity:1, weight:5, cost:5, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(1, 1), (40, 2)], flags:["SHOW_MODS"], desc:["A simple cloth or leather pouch with two strings attached. It is used to hurl", "pebbles or iron shots. You can 'f'ire with it after you 'w'ield it."]),
    (id:78, name:"Arrow", ch:"{", color:15, tval:17, sval:1, pval:0, fuel:0, spell:"", depth:3, rarity:1, weight:2, cost:1, ac:0, dice:"1d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(3, 1), (15, 1), (50, 1)], flags:["SHOW_MODS"], desc:["A simple metal head on a piece of wood or bamboo, fitted with some feathers.", "You can use it for 'f'iring a bow."]),
    (id:79, name:"Seeker Arrow", ch:"{", color:13, tval:17, sval:2, pval:0, fuel:0, spell:"", depth:55, rarity:1, weight:2, cost:20, ac:0, dice:"4d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(55, 2), (80, 2)], flags:["SHOW_MODS"], desc:["A precision-made arrow, which allows you to hit precisely the most vulnerable", "place of an opponent. You can use it for 'f'iring a bow."]),
    (id:80, name:"Bolt", ch:"{", color:2, tval:18, sval:1, pval:0, fuel:0, spell:"", depth:3, rarity:1, weight:3, cost:2, ac:0, dice:"1d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(3, 1), (25, 1), (60, 1)], flags:["SHOW_MODS"], desc:["A short metal arrow, to be 'f'ired with a crossbow."]),
    (id:81, name:"Seeker Bolt", ch:"{", color:14, tval:18, sval:2, pval:0, fuel:0, spell:"", depth:65, rarity:1, weight:3, cost:25, ac:0, dice:"4d5", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(65, 2), (90, 2)], flags:["SHOW_MODS"], desc:["A precision-made bolt, which allows you to hit exactly the most vulnerable", "place of an opponent. You can use it for 'f'iring a crossbow."]),
    (id:82, name:"Rounded Pebble", ch:"{", color:2, tval:16, sval:0, pval:0, fuel:0, spell:"", depth:0, rarity:1, weight:4, cost:1, ac:0, dice:"1d2", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(0, 1), (10, 2)], flags:["SHOW_MODS"], desc:["Small round stones. When fired with a sling, they could even hurt a giant.", "You can use them for 'f'iring a sling."]),
    (id:83, name:"Iron Shot", ch:"{", color:2, tval:16, sval:1, pval:0, fuel:0, spell:"", depth:3, rarity:1, weight:5, cost:2, ac:0, dice:"1d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(3, 1), (40, 2)], flags:["SHOW_MODS"], desc:["Metal balls, made for shooting with slings. You can use them for 'f'iring a", "sling."]),
    (id:84, name:"Shovel", ch:"\\", color:2, tval:20, sval:1, pval:1, fuel:0, spell:"", depth:1, rarity:1, weight:60, cost:10, ac:0, dice:"1d2", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 2)], flags:["TUNNEL"], desc:["A simple digging tool for shovelling away rubble and maybe even soft rock."]),
    (id:85, name:"Gnomish Shovel", ch:"\\", color:13, tval:20, sval:2, pval:2, fuel:0, spell:"", depth:20, rarity:1, weight:60, cost:100, ac:0, dice:"1d2", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 3)], flags:["TUNNEL"], desc:["Crafted by the gnomes, its design profits greatly from the gnomes' expertise", "honed in the burrowing of their hovels."]),
    (id:86, name:"Dwarven Shovel", ch:"\\", color:14, tval:20, sval:3, pval:3, fuel:0, spell:"", depth:40, rarity:1, weight:120, cost:200, ac:0, dice:"1d3", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(40, 4)], flags:["TUNNEL"], desc:["The lighter digging tool used by dwarves to remove debris, but also good", "enough to clear away bits of rock when no pick is easily available."]),
    (id:87, name:"Pick", ch:"\\", color:2, tval:20, sval:4, pval:1, fuel:0, spell:"", depth:5, rarity:1, weight:150, cost:50, ac:0, dice:"1d3", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 2)], flags:["TUNNEL"], desc:["A heavy digging tool, primarily for earthworking, but also good for tunnelling", "through stone, if one is willing to perform the time-consuming labour."]),
    (id:88, name:"Orcish Pick", ch:"\\", color:5, tval:20, sval:5, pval:2, fuel:0, spell:"", depth:30, rarity:1, weight:180, cost:300, ac:0, dice:"1d3", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(30, 3)], flags:["TUNNEL"], desc:["Although orcs tend to dig rather untidy mines and overcome difficulties in", "this work less by skill than mere stubbornness, they have amassed", "quite some expertise in mining, which has gone into this digging tool."]),
    (id:89, name:"Dwarven Pick", ch:"\\", color:6, tval:20, sval:6, pval:3, fuel:0, spell:"", depth:50, rarity:1, weight:200, cost:600, ac:0, dice:"1d4", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(50, 4)], flags:["TUNNEL"], desc:["The dwarves, miners of legend, have made this pick, which is so expertly", "crafted that even weaklings can bore through solid rock with it."]),
    (id:90, name:"Elven Cloak", ch:"(", color:13, tval:35, sval:2, pval:0, fuel:0, spell:"", depth:30, rarity:1, weight:5, cost:1500, ac:4, dice:"0d0", to_h:0, to_d:0, to_a:4, lite:0, activate:"", btval:0, bsval:0, alloc:[(30, 4)], flags:["IGNORE_ACID", "IGNORE_COLD", "IGNORE_ELEC", "IGNORE_FIRE", "LUCK", "STEALTH"], desc:["A wonderfully light cloak coloured in brown and green hues. Its colouring", "greatly helps the wearer to avoid undesired attention. Wearing it makes you", "feel lucky and somehow you seem to see what was meant to stay unseen."]),
    (id:91, name:"Pair of Soft Leather Boots", ch:"]", color:15, tval:30, sval:2, pval:0, fuel:0, spell:"", depth:3, rarity:1, weight:20, cost:7, ac:2, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(3, 1)], flags:[], desc:["A pair of low boots, comfortable to wear."]),
    (id:92, name:"Pair of Hard Leather Boots", ch:"]", color:15, tval:30, sval:3, pval:0, fuel:0, spell:"", depth:5, rarity:1, weight:40, cost:12, ac:3, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(5, 1)], flags:[], desc:["A pair of boots, with hardened leather at the caps, offering a little", "extra protection for the feet."]),
    (id:93, name:"Pair of Metal Shod Boots", ch:"]", color:2, tval:30, sval:6, pval:0, fuel:0, spell:"", depth:20, rarity:1, weight:80, cost:50, ac:6, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:[], desc:["Heavy boots, with metal strips at the toes, heels and other vulnerable parts,", "to better protect the wearer's feet from harm."]),
    (id:94, name:"Hard Leather Cap", ch:"]", color:7, tval:32, sval:2, pval:0, fuel:0, spell:"", depth:3, rarity:1, weight:15, cost:12, ac:2, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(3, 1)], flags:[], desc:["A piece of protective headgear made from hardened leather, just covering the", "skull."]),
    (id:95, name:"Metal Cap", ch:"]", color:2, tval:32, sval:3, pval:0, fuel:0, spell:"", depth:10, rarity:1, weight:20, cost:30, ac:3, dice:"1d1", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(10, 1)], flags:[], desc:["A metal skullcap with nose and cheekguards."]),
    (id:96, name:"Iron Helm", ch:"]", color:2, tval:32, sval:5, pval:0, fuel:0, spell:"", depth:20, rarity:1, weight:75, cost:75, ac:5, dice:"1d3", to_h:0, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(20, 1)], flags:[], desc:["A large helmet that can protect the entire head. Ventilation and bad vision", "can be a problem, however."]),
