    (id:778, name:"Bluesteel Blade", ch:"|", color:6, tval:23, sval:31, pval:0, fuel:0, spell:"", depth:60, rarity:1800, weight:50, cost:6000, ac:0, dice:"1d6", to_h:4, to_d:0, to_a:0, lite:0, activate:"", btval:0, bsval:0, alloc:[(60, 20)], flags:["SHOW_MODS", "VORPAL"], desc:["A small sword made of a blueish metal with a strangely rough surface. As anything is hurt", "with it, the weapon will stick inside the wound and cause horrible wounds when torn away."]),
    (id:779, name:"Amulet of the Serpents", ch:"\"", color:13, tval:40, sval:17, pval:0, fuel:0, spell:"", depth:25, rarity:1, weight:3, cost:10000, ac:0, dice:"0d0", to_h:0, to_d:0, to_a:0, lite:0, activate:"BA_POIS_4", btval:0, bsval:0, alloc:[(25, 1)], flags:["ACTIVATE", "DEX", "RES_POIS"], desc:["A petrified serpent's tongue, hung on a thin chain to be clasped around your neck. It makes you", "like unto snakes, able to wriggle out of tight corners, impervious to poisons and poisonous", "yourself."]),
